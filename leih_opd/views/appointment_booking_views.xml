<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_booking_form_opd" model="ir.ui.view">
        <field name="name">appointment.booking.form.opd</field>
        <field name="model">appointment.booking</field>
        <field name="inherit_id" ref="leih19.appointment_booking_form_view"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_confirm_serial" type="object"
                        string="Confirm Serial" class="btn-primary"
                        invisible="serial_no != 0"/>
                <button name="action_print_token" type="object"
                        string="Print Token" icon="fa-print"
                        class="btn-primary" invisible="not doctor_name"/>
                <!-- The arrival desk's one button: completes the identity,
                     registers the patient and takes the fee. -->
                <button name="action_register_arrival" type="object"
                        string="Register Arrival &amp; Payment" class="btn-primary"
                        invisible="status in ('arrived', 'in_consultation', 'converted')"/>
                <button name="action_start_consultation" type="object"
                        string="Start Consultation" class="btn-primary"
                        invisible="status != 'arrived'"/>
                <button name="action_start_consultation" type="object"
                        string="Open Prescription"
                        invisible="status != 'in_consultation'"/>
                <button name="action_complete_consultation" type="object"
                        string="Mark Completed"
                        invisible="status not in ('arrived', 'in_consultation')"/>
                <button name="action_print_id_card" type="object"
                        string="Print ID Card" icon="fa-id-card"
                        invisible="not patient_id"/>
                <button name="action_open_opd_ticket" type="object"
                        string="Open OPD Ticket" invisible="not opd_ticket_id"/>
            </header>

            <!-- The banner and the button box belong above the first group. -->
            <group name="group_appointment" position="before">
                <!-- Stays on screen for as long as the mismatch does, so it
                     cannot be dismissed and forgotten like the dialog can. -->
                <div class="alert alert-warning" role="alert"
                     invisible="not schedule_warning">
                    <i class="fa fa-calendar-times-o me-1" title="Schedule warning"/>
                    <field name="schedule_warning" class="oe_inline" readonly="1" nolabel="1"/>
                </div>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_prescriptions" type="object"
                            class="oe_stat_button" icon="fa-stethoscope"
                            invisible="prescription_count == 0">
                        <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                    </button>
                </div>
            </group>

            <!-- ============ Appointment: what session, what day, what time ===========
                 Every group on this form is one column and the groups are
                 stacked, so Tab walks the form top to bottom without ever
                 jumping back up. The order inside each group is the order the
                 desk asks the questions in.
            -->
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="placeholder">Assigned automatically on save</attribute>
            </field>
            <field name="doctor_name" position="after">
                <field name="schedule_id"/>
                <field name="appointment_date"/>
            </field>
            <!-- `date` is the base module's single date field and nothing in the
                 OPD flow reads it; `appointment_date` is what the serial,
                 capacity, token and VN all work off. It is kept (and kept in
                 step with appointment_date by a compute) because the leih19
                 booking report still prints it, but showing both would put two
                 date fields in the desk's Tab path, one of which does nothing. -->
            <field name="date" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="time" position="attributes">
                <attribute name="placeholder">e.g. 05:30 PM</attribute>
            </field>

            <!-- ============ Patient Information: one uninterrupted column ============ -->
            <field name="patient_name" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="placeholder">Name as the patient gives it</attribute>
            </field>
            <field name="age" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="age" position="after">
                <field name="date_of_birth"/>
                <field name="age_display"/>
            </field>
            <field name="phone" position="attributes">
                <attribute name="placeholder">01XXXXXXXXX</attribute>
            </field>
            <!-- Address is collected at the arrival desk, not over the counter
                 at booking, so it must not look like a required field here. -->
            <field name="address" position="attributes">
                <attribute name="placeholder">Taken at arrival</attribute>
            </field>
            <!-- The patient record, once one exists. Read-only on purpose: it is
                 created by the arrival wizard, not typed here, so it also falls
                 out of the Tab path instead of interrupting the identity. -->
            <field name="patient_status" position="after">
                <field name="patient_id" readonly="1" invisible="not patient_id"
                       context="{'patient_display_contact': 1}"/>
            </field>

            <!-- ============ Fee ============
                 Non-accounting: registering the arrival is the payment, these
                 fields are the whole audit trail. -->
            <field name="payment_done" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="payment_done" position="after">
                <field name="payment_note" invisible="not payment_done"/>
                <field name="arrived_on" readonly="1" invisible="not arrived_on"/>
                <field name="collected_by" readonly="1" invisible="not collected_by"/>
            </field>

            <!-- ============ Numbers ============
                 All allocated by buttons, never typed, so this group sits last
                 and below the data entry: reception reads it back off the slip
                 in the patient's hand. Two columns is fine here precisely
                 because nothing in it is a Tab stop. -->
            <group name="group_fee" position="after">
                <group name="group_numbers" string="Serial, Token &amp; Identifiers" col="4">
                    <field name="serial_no"/>
                    <label for="token_no" string="Consultation Token"/>
                    <div>
                        <field name="token_no" class="oe_inline" readonly="1"/>
                        <span class="text-muted" invisible="not token_date">
                            &#160;(for <field name="token_date" class="oe_inline" readonly="1"/>)
                        </span>
                    </div>
                    <field name="cn_number" readonly="1"/>
                    <field name="cn_date" readonly="1"/>
                    <field name="hn_number"/>
                    <field name="vn_date"/>
                    <field name="location"/>
                    <field name="opd_ticket_id" invisible="not opd_ticket_id"/>
                    <field name="token_printed_on" readonly="1" invisible="not token_printed_on"/>
                </group>
            </group>
        </field>
    </record>

    <record id="appointment_booking_list_opd" model="ir.ui.view">
        <field name="name">appointment.booking.list.opd</field>
        <field name="model">appointment.booking</field>
        <field name="inherit_id" ref="leih19.appointment_booking_tree_view"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-info">status == 'arrived'</attribute>
                <attribute name="decoration-warning">status == 'in_consultation'</attribute>
                <attribute name="decoration-muted">status == 'converted'</attribute>
            </list>
            <field name="doctor_name" position="after">
                <field name="schedule_id" optional="show"/>
                <field name="appointment_date" optional="show"/>
                <field name="token_no" optional="show"/>
                <field name="serial_no" optional="show"/>
                <field name="cn_number" optional="hide"/>
                <field name="hn_number" optional="hide"/>
            </field>
            <!-- Mirrors appointment_date, so it is noise next to it. -->
            <field name="date" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="status" position="attributes">
                <attribute name="widget">badge</attribute>
            </field>
            <field name="patient_status" position="after">
                <field name="patient_id" optional="hide"/>
                <field name="collected_by" optional="hide"/>
                <field name="opd_ticket_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- The booking list had no search view at all: no way to pull up today's
         serials, one doctor's session, or the people still waiting to arrive. -->
    <record id="appointment_booking_search_opd" model="ir.ui.view">
        <field name="name">appointment.booking.search.opd</field>
        <field name="model">appointment.booking</field>
        <field name="arch" type="xml">
            <search string="Appointments">
                <!-- "Ask the patient their name" is the arrival desk's whole
                     lookup, so name/mobile/serial/token all answer one box. -->
                <field name="patient_name" string="Patient / Mobile / Serial"
                       filter_domain="['|', '|', '|', ('patient_name', 'ilike', self), ('phone', 'ilike', self), ('name', 'ilike', self), ('cn_number', 'ilike', self)]"/>
                <field name="patient_id"/>
                <field name="doctor_name"/>
                <field name="schedule_id"/>
                <field name="serial_no"/>
                <field name="token_no"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Upcoming" name="upcoming"
                        domain="[('appointment_date', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Not Arrived Yet" name="waiting"
                        domain="[('status', 'in', ('pending', 'reached', 'paid'))]"/>
                <filter string="In Queue" name="in_queue"
                        domain="[('status', 'in', ('arrived', 'in_consultation'))]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'converted')]"/>
                <separator/>
                <filter string="Serial Not Issued" name="no_serial" domain="[('serial_no', '=', 0)]"/>
                <filter string="Fee Collected" name="paid_filter" domain="[('payment_done', '=', True)]"/>
                <filter string="Fee Not Collected" name="unpaid" domain="[('payment_done', '=', False)]"/>
                <separator/>
                <filter string="My Patients" name="my_patients"
                        domain="[('doctor_name.user_id', '=', uid)]"/>
                <filter string="Collected by Me" name="my_collections"
                        domain="[('collected_by', '=', uid)]"/>
                <separator/>
                <filter string="Group by Doctor" name="group_doctor" context="{'group_by': 'doctor_name'}"/>
                <filter string="Group by Session" name="group_session" context="{'group_by': 'schedule_id'}"/>
                <filter string="Group by Appointment Date" name="group_date" context="{'group_by': 'appointment_date'}"/>
                <filter string="Group by Status" name="group_status" context="{'group_by': 'status'}"/>
                <filter string="Group by Collector" name="group_collector" context="{'group_by': 'collected_by'}"/>
            </search>
        </field>
    </record>

    <!-- leih19 already publishes this action under LEIS > Appointment; give it a
         readable name and the search view instead of adding a second menu. -->
    <record id="leih19.appointment_booking_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="search_view_id" ref="appointment_booking_search_opd"/>
    </record>
</odoo>
