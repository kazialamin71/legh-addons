<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="doctor_collection_report_wizard_form" model="ir.ui.view">
        <field name="name">appointment.doctor.collection.wizard.form</field>
        <field name="model">appointment.doctor.collection.wizard</field>
        <field name="arch" type="xml">
            <form string="Doctor-wise Collection">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Options">
                        <field name="include_detail"/>
                    </group>
                </group>
                <group string="Doctors">
                    <field name="doctor_ids" nolabel="1" widget="many2many_tags"
                           options="{'no_quick_create': True, 'no_create_edit': True}"
                           placeholder="Leave empty for all doctors..."/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" icon="fa-print" data-hotkey="q"/>
                    <button name="action_open_list" type="object" string="View on Screen"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="doctor_collection_report_action" model="ir.actions.act_window">
        <field name="name">Doctor-wise Collection</field>
        <field name="res_model">appointment.doctor.collection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_doctor_collection_report" name="Doctor-wise Collection"
              parent="leih19.menu_leis_reports"
              action="doctor_collection_report_action" sequence="20"/>
    <menuitem id="menu_appointment_doctor_collection" name="Doctor-wise Collection"
              parent="leih19.menu_leis_appointment"
              action="doctor_collection_report_action" sequence="40"/>
</odoo>
