<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="seq_team_charge_settlement" model="ir.sequence">
        <field name="name">Doctor Share Settlement</field>
        <field name="code">team.charge.settlement</field>
        <field name="prefix">DS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="team_charge_settlement_form" model="ir.ui.view">
        <field name="name">team.charge.settlement.form</field>
        <field name="model">team.charge.settlement</field>
        <field name="arch" type="xml">
            <form string="Doctor's Share Settlement">
                <header>
                    <button name="action_collect" type="object" string="Gather Shares"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Pay Doctor"
                            class="btn-primary"
                            invisible="state != 'draft' or charge_count == 0"
                            confirm="This hands the cash over and posts it out of the counter. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel'"
                            confirm="This reverses the journal entries and releases every share so it can be paid again. Continue?"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_acc_moves" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="acc_move_count == 0">
                            <field name="acc_move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Doctor" name="doctor">
                            <field name="doctor_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="payment_type" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="payment_note" readonly="state != 'draft'"
                                   placeholder="e.g. cash, bKash, cheque no."/>
                        </group>
                        <group string="What to Settle" name="scope">
                            <field name="admission_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="date_from" readonly="state != 'draft'"
                                   invisible="admission_id"/>
                            <field name="date_to" readonly="state != 'draft'"
                                   invisible="admission_id"/>
                            <field name="charge_count"/>
                            <field name="amount"/>
                            <field name="acc_move_count" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="charge_count != 0">
                        Choose the doctor, then either an <b>admission</b> or a date
                        range, and press <b>Gather Shares</b>. Only what the patient
                        has already paid in can be handed over, and only the part
                        that has not been paid out before.
                    </div>
                    <notebook invisible="charge_count == 0">
                        <page string="Shares Being Paid" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="description" readonly="1"/>
                                    <field name="charge_id" column_invisible="True"/>
                                    <field name="bill_line_id" column_invisible="True"/>
                                    <field name="owed" sum="Doctor's Share" readonly="1"/>
                                    <field name="already_paid" sum="Already Paid" readonly="1"/>
                                    <field name="amount" sum="Paying Now"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Reduce "Paying Now" to hand over part of a share; the
                                rest stays owed and can be paid on a later settlement.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="team_charge_settlement_list" model="ir.ui.view">
        <field name="name">team.charge.settlement.list</field>
        <field name="model">team.charge.settlement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="doctor_id"/>
                <field name="admission_id" optional="show"/>
                <field name="payment_type" optional="hide"/>
                <field name="charge_count"/>
                <field name="amount" sum="Paid"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="team_charge_settlement_action" model="ir.actions.act_window">
        <field name="name">Doctor Settlements</field>
        <field name="res_model">team.charge.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pay a doctor at the counter</p>
            <p>Each settlement hands over only what the patient has already paid in,
               posts it out of the counter cash, and shows on the cash collection
               report as money leaving the drawer.</p>
        </field>
    </record>

    <!-- Brings the old scheme's unposted doctors' shares onto the ledger.
         Manual and idempotent: read the Doctor's Share report first. -->
    <record id="action_open_team_payables" model="ir.actions.server">
        <field name="name">Bring Doctors' Shares onto the Ledger</field>
        <field name="model_id" ref="model_team_charge_settlement"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_team_payables()</field>
    </record>

    <menuitem id="menu_open_team_payables"
              name="Bring Doctors' Shares onto the Ledger"
              parent="account.menu_finance_configuration"
              action="action_open_team_payables"
              groups="account.group_account_manager"
              sequence="102"/>
</odoo>
