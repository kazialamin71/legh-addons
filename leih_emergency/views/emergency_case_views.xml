<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- ======================= FORM ======================= -->
    <record id="emergency_case_form" model="ir.ui.view">
        <field name="name">emergency.case.form</field>
        <field name="model">emergency.case</field>
        <field name="arch" type="xml">
            <form string="Emergency Case" class="o_emergency_form">
                <header>
                    <button name="action_confirm_triage" type="object"
                            string="Confirm Triage" class="btn-primary"
                            invisible="state != 'arrived'"/>
                    <button name="action_start_treatment" type="object"
                            string="Start Treatment" class="btn-primary"
                            invisible="state != 'triaged'"/>
                    <button name="action_collect_payment" type="object"
                            string="Collect Payment"
                            invisible="due &lt;= 0 or state in ('closed', 'cancelled')"/>
                    <button name="action_open_disposition" type="object"
                            string="Disposition" class="btn-primary"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_register_patient" type="object"
                            string="Register Patient" icon="fa-id-card"
                            invisible="patient_id or state == 'cancelled'"/>
                    <button name="action_print_ed_slip" type="object"
                            string="Print ED Slip" icon="fa-print"/>
                    <button name="action_reset_to_triaged" type="object"
                            string="Reopen" invisible="state != 'closed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="arrived,triaged,in_treatment,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_admission" type="object"
                                class="oe_stat_button" icon="fa-hospital-o"
                                invisible="not admission_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Admission</span>
                                <span class="o_stat_value"><field name="admission_id"/></span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="ED No."/>
                        <h1><field name="name" readonly="1" class="oe_inline"/></h1>
                    </div>

                    <!-- The board's own warning, repeated on the case so a
                         breach is visible to whoever opens it. -->
                    <div class="alert alert-danger" role="alert"
                         invisible="not is_breached">
                        Waiting <field name="waiting_display" class="oe_inline" readonly="1"/> -
                        past the <field name="target_minutes" class="oe_inline" readonly="1"/> minute
                        target for this triage level.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="patient_id or state == 'cancelled'">
                        No hospital record yet. Treatment does not wait for one - press
                        <b>Register Patient</b> once somebody can identify them.
                    </div>

                    <group>
                        <group string="Patient" name="patient">
                            <field name="patient_id" readonly="1" invisible="not patient_id"
                                   context="{'patient_display_contact': 1}"/>
                            <field name="hn_number" invisible="not patient_id"/>
                            <field name="patient_name"
                                   placeholder="Name, or a description if unknown"/>
                            <field name="age"/>
                            <field name="sex"/>
                            <field name="mobile"/>
                            <field name="address"/>
                            <field name="attendant_name"/>
                            <field name="attendant_contact"/>
                        </group>
                        <group string="Arrival" name="arrival">
                            <field name="arrival_time"/>
                            <field name="arrival_mode"/>
                            <field name="referred_from"
                                   invisible="arrival_mode != 'referral'"/>
                            <field name="waiting_display" readonly="1"
                                   invisible="state in ('closed', 'cancelled')"/>
                            <field name="is_breached" invisible="1"/>
                            <field name="target_minutes" invisible="1"/>
                            <field name="attending_doctor"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="treatment_start" readonly="1"
                                   invisible="not treatment_start"/>
                            <field name="disposition" invisible="state != 'closed'"/>
                            <field name="disposition_time" invisible="state != 'closed'"/>
                            <field name="transferred_to" invisible="not transferred_to"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Triage &amp; Vitals" name="triage">
                            <group>
                                <group string="Triage">
                                    <field name="triage_level"/>
                                    <field name="triage_time" readonly="1"
                                           invisible="not triage_time"/>
                                    <field name="triaged_by" readonly="1"
                                           invisible="not triaged_by"/>
                                    <field name="chief_complaint"
                                           placeholder="What brought the patient in..."/>
                                </group>
                                <group string="Vitals">
                                    <label for="bp_systolic" string="Blood Pressure"/>
                                    <div>
                                        <field name="bp_systolic" class="oe_inline"/> /
                                        <field name="bp_diastolic" class="oe_inline"/> mmHg
                                    </div>
                                    <field name="pulse"/>
                                    <field name="respiratory_rate"/>
                                    <field name="temperature"/>
                                    <field name="spo2"/>
                                    <field name="gcs"/>
                                </group>
                            </group>
                        </page>

                        <page string="Treatment" name="treatment">
                            <group>
                                <field name="provisional_diagnosis"/>
                            </group>
                            <field name="treatment_note"
                                   placeholder="Clinical notes, procedures done, response..."/>
                        </page>

                        <!-- Consumables and investigations are the bulk of an ED
                             bill, so charging is a first-class page, not a
                             sub-tab of billing. -->
                        <page string="Charges" name="charges">
                            <field name="charge_ids">
                                <list editable="bottom">
                                    <field name="charge_type"/>
                                    <field name="product_id"
                                           options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="item_id"
                                           options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="description"/>
                                    <field name="unit_id" optional="hide"/>
                                    <field name="provider_id" optional="hide"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="discount" optional="show"/>
                                    <field name="total_amount" sum="Total"/>
                                    <field name="date" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_charges"/>
                                <field name="paid"/>
                                <field name="due" class="oe_subtotal_footer_separator"/>
                                <field name="payment_type"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            </group>
                        </page>

                        <page string="Receipts" name="receipts"
                              invisible="not money_receipt_ids">
                            <field name="money_receipt_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Collected"/>
                                    <field name="type"/>
                                    <field name="user_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Medico-Legal" name="mlc">
                            <group>
                                <group>
                                    <field name="is_medico_legal"/>
                                    <field name="mlc_type" invisible="not is_medico_legal"
                                           required="is_medico_legal"/>
                                </group>
                                <group invisible="not is_medico_legal">
                                    <field name="police_station"/>
                                    <field name="gd_number"/>
                                    <field name="informed_officer"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= LIST ======================= -->
    <record id="emergency_case_list" model="ir.ui.view">
        <field name="name">emergency.case.list</field>
        <field name="model">emergency.case</field>
        <field name="arch" type="xml">
            <list string="Emergency Cases"
                  decoration-danger="triage_level == 'critical' or is_breached"
                  decoration-warning="triage_level == 'urgent'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="arrival_time"/>
                <field name="patient_name"/>
                <field name="age" optional="show"/>
                <field name="sex" optional="hide"/>
                <field name="hn_number" optional="show"/>
                <field name="triage_level" widget="badge"
                       decoration-danger="triage_level == 'critical'"
                       decoration-warning="triage_level == 'urgent'"
                       decoration-success="triage_level == 'standard'"/>
                <field name="waiting_display" string="Waiting"/>
                <field name="is_breached" optional="hide"/>
                <field name="arrival_mode" optional="hide"/>
                <field name="attending_doctor" optional="show"/>
                <field name="is_medico_legal" optional="hide"/>
                <field name="total_charges" sum="Charges" optional="show"/>
                <field name="paid" sum="Paid" optional="hide"/>
                <field name="due" sum="Due" optional="show"/>
                <field name="disposition" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'triaged'"
                       decoration-warning="state == 'in_treatment'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ==================== THE ED BOARD ==================== -->
    <record id="emergency_case_kanban" model="ir.ui.view">
        <field name="name">emergency.case.kanban</field>
        <field name="model">emergency.case</field>
        <field name="arch" type="xml">
            <!-- Sickest first, then longest waiting: triage_sequence exists
                 precisely so this sort can happen in SQL. -->
            <kanban default_group_by="triage_level" class="o_emergency_board"
                    default_order="triage_sequence, arrival_time"
                    records_draggable="false" group_create="false" quick_create="false">
                <field name="triage_level"/>
                <field name="is_breached"/>
                <field name="waiting_display"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{record.is_breached.raw_value ? 'o_ed_breach ps-2' : ''}">
                            <div class="d-flex align-items-start">
                                <div class="flex-grow-1">
                                    <div class="fw-bold fs-5">
                                        <field name="patient_name"/>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="name"/>
                                        <t t-if="record.age.raw_value"> · <field name="age"/></t>
                                        <t t-if="record.hn_number.raw_value"> · HN <field name="hn_number"/></t>
                                    </div>
                                </div>
                                <span t-if="record.is_medico_legal.raw_value"
                                      class="badge text-bg-dark">MLC</span>
                            </div>
                            <div class="mt-1 text-truncate" t-if="record.chief_complaint.raw_value">
                                <field name="chief_complaint"/>
                            </div>
                            <div class="mt-2">
                                <span t-if="record.waiting_display.raw_value"
                                      t-attf-class="badge #{record.is_breached.raw_value ? 'text-bg-danger' : 'text-bg-light'}">
                                    <field name="waiting_display"/>
                                </span>
                                <span class="badge text-bg-secondary ms-1">
                                    <field name="state"/>
                                </span>
                                <span t-if="record.due.raw_value > 0"
                                      class="badge text-bg-warning ms-1">
                                    Due <field name="due"/>
                                </span>
                            </div>
                            <field name="is_medico_legal" invisible="1"/>
                            <field name="due" invisible="1"/>
                            <field name="hn_number" invisible="1"/>
                            <field name="age" invisible="1"/>
                            <field name="chief_complaint" invisible="1"/>
                            <footer class="pt-2">
                                <button name="action_confirm_triage" type="object"
                                        class="btn btn-primary btn-sm"
                                        invisible="state != 'arrived'">Triage</button>
                                <button name="action_start_treatment" type="object"
                                        class="btn btn-primary btn-sm"
                                        invisible="state != 'triaged'">Start</button>
                                <button name="action_open_disposition" type="object"
                                        class="btn btn-outline-secondary btn-sm ms-1"
                                        invisible="state in ('closed', 'cancelled')">Dispose</button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ====================== SEARCH ====================== -->
    <record id="emergency_case_search" model="ir.ui.view">
        <field name="name">emergency.case.search</field>
        <field name="model">emergency.case</field>
        <field name="arch" type="xml">
            <search string="Emergency Cases">
                <field name="patient_name" string="Patient / ED No. / Mobile"
                       filter_domain="['|', '|', ('patient_name', 'ilike', self), ('name', 'ilike', self), ('mobile', 'ilike', self)]"/>
                <field name="patient_id"/>
                <field name="attending_doctor"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('arrival_time', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Open Cases" name="open"
                        domain="[('state', 'in', ('arrived', 'triaged', 'in_treatment'))]"/>
                <filter string="Awaiting Triage" name="untriaged"
                        domain="[('state', '=', 'arrived')]"/>
                <filter string="Target Breached" name="breached"
                        domain="[('is_breached', '=', True)]"/>
                <separator/>
                <filter string="Critical" name="critical" domain="[('triage_level', '=', 'critical')]"/>
                <filter string="Urgent" name="urgent" domain="[('triage_level', '=', 'urgent')]"/>
                <filter string="Non-urgent" name="standard" domain="[('triage_level', '=', 'standard')]"/>
                <separator/>
                <filter string="Medico-Legal" name="mlc" domain="[('is_medico_legal', '=', True)]"/>
                <filter string="Has Due" name="due" domain="[('due', '&gt;', 0)]"/>
                <filter string="Admitted" name="admitted" domain="[('disposition', '=', 'admitted')]"/>
                <separator/>
                <filter string="My Patients" name="mine"
                        domain="[('attending_doctor.user_id', '=', uid)]"
                        groups="base.group_user"/>
                <separator/>
                <filter string="Group by Triage" name="g_triage" context="{'group_by': 'triage_level'}"/>
                <filter string="Group by Status" name="g_state" context="{'group_by': 'state'}"/>
                <filter string="Group by Disposition" name="g_disp" context="{'group_by': 'disposition'}"/>
                <filter string="Group by Doctor" name="g_doc" context="{'group_by': 'attending_doctor'}"/>
                <filter string="Group by Arrival Date" name="g_date" context="{'group_by': 'arrival_time:day'}"/>
            </search>
        </field>
    </record>

    <record id="emergency_board_action" model="ir.actions.act_window">
        <field name="name">ED Board</field>
        <field name="res_model">emergency.case</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="emergency_case_kanban"/>
        <field name="search_view_id" ref="emergency_case_search"/>
        <field name="domain">[('state', 'in', ('arrived', 'triaged', 'in_treatment'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The department is clear</p>
            <p>
                Register an arrival and the patient appears here. Triage decides
                the order they are seen in - not the order they walked in.
            </p>
        </field>
    </record>

    <record id="emergency_case_action" model="ir.actions.act_window">
        <field name="name">Emergency Cases</field>
        <field name="res_model">emergency.case</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="emergency_case_list"/>
        <field name="search_view_id" ref="emergency_case_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
