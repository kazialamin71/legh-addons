<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="emergency_payment_wizard_form" model="ir.ui.view">
        <field name="name">emergency.payment.wizard.form</field>
        <field name="model">emergency.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Collect Payment">
                <field name="case_id" invisible="1"/>
                <group>
                    <group string="Account">
                        <field name="total_charges"/>
                        <field name="already_paid"/>
                        <field name="due"/>
                    </group>
                    <group string="Collect">
                        <field name="amount"/>
                        <field name="payment_type"
                               options="{'no_quick_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_collect" type="object" string="Collect"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
