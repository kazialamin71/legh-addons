<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="purchase_order_form_supplier_products" model="ir.ui.view">
        <field name="name">purchase.order.form.supplier.products</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- The flag sits with the supplier, because that is the choice it
                 qualifies: pick the supplier, then decide whether the product
                 list is theirs or everything. -->
            <field name="partner_id" position="after">
                <field name="show_all_products" widget="boolean_toggle"/>
            </field>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                   position="attributes">
                <attribute name="context">{
                    'po_filter_supplier_id': parent.partner_id,
                    'po_show_all_products': parent.show_all_products,
                    'partner_id': parent.partner_id,
                    'quantity': product_qty,
                    'uom': product_uom_id,
                    'company_id': parent.company_id,
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
