<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_pharmacy_requisition" model="ir.sequence">
        <field name="name">Pharmacy Requisition</field>
        <field name="code">pharmacy.requisition</field>
        <field name="prefix">PHR-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_pharmacy_return" model="ir.sequence">
        <field name="name">Pharmacy Medicine Return</field>
        <field name="code">pharmacy.return</field>
        <field name="prefix">PHRET-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
