<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_pharmacy_requisition" model="ir.actions.report">
        <field name="name">Pharmacy Requisition</field>
        <field name="model">pharmacy.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih_pharmacy.report_pharmacy_requisition_document</field>
        <field name="report_file">leih_pharmacy.report_pharmacy_requisition_document</field>
        <field name="print_report_name">'Pharmacy Req - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_pharmacy_requisition"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pharmacy_requisition_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>

                        <h2 class="doc_title">PHARMACY REQUISITION</h2>

                        <table class="meta">
                            <tr>
                                <td style="width:34%"><span class="lbl">Requisition No</span>
                                    <span t-out="o.name or '-'"/></td>
                                <td style="width:33%"><span class="lbl">Admission</span>
                                    <span t-out="o.admission_id.name or '-'"/></td>
                                <td style="width:33%"><span class="lbl">Date</span>
                                    <span t-field="o.date" t-options="{'widget': 'datetime'}"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Patient</span>
                                    <span t-out="o.patient_id.name if o.patient_id else '-'"/></td>
                                <td><span class="lbl">Requested By</span>
                                    <span t-out="o.requested_by or '-'"/></td>
                                <td><span class="lbl">Location</span>
                                    <span t-out="o.location_id.display_name or '-'"/></td>
                            </tr>
                        </table>

                        <table class="items">
                            <thead>
                                <tr>
                                    <th style="width:6%">#</th>
                                    <th style="width:40%">Medicine</th>
                                    <th style="width:13%" class="num">Requested</th>
                                    <th style="width:13%" class="num">Issued</th>
                                    <th style="width:14%" class="num">Unit Price</th>
                                    <th style="width:14%" class="num">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr>
                                        <td class="ctr"><span t-out="idx"/></td>
                                        <td><span t-out="line.product_id.display_name or '-'"/></td>
                                        <td class="num"><span t-out="'%g' % (line.requested_qty or 0)"/></td>
                                        <td class="num"><span t-out="'%g' % (line.issued_qty or 0)"/></td>
                                        <td class="num"><span t-out="'%.2f' % (line.unit_price or 0)"/></td>
                                        <td class="num"><span t-out="'%.2f' % (line.subtotal or 0)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="totals">
                            <tr class="grand"><td>Net Amount</td>
                                <td class="num"><span t-out="'%.2f' % o.net_amount"/></td></tr>
                        </table>

                        <div class="sign_row" style="display:flex; justify-content:space-between;">
                            <span class="sign_box">Issued By (Pharmacy)</span>
                            <span class="sign_box">Received By (Nurse)</span>
                        </div>

                        <p class="foot_note">*** Computer-generated pharmacy requisition. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
