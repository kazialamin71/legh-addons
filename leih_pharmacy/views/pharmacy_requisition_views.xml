<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="pharmacy_requisition_list_view" model="ir.ui.view">
        <field name="name">pharmacy.requisition.list</field>
        <field name="model">pharmacy.requisition</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-success="state == 'issued'"
                  decoration-muted="state in ('returned','cancelled')">
                <field name="name"/>
                <field name="date"/>
                <field name="admission_id"/>
                <field name="patient_id"/>
                <field name="net_amount" sum="Net"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="pharmacy_requisition_form_view" model="ir.ui.view">
        <field name="name">pharmacy.requisition.form</field>
        <field name="model">pharmacy.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_issue" type="object" string="Issue"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="leih_pharmacy.group_pharmacy_dispenser"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('issued','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="admission_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="patient_id"/>
                            <field name="requested_by"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="net_amount"/>
                            <field name="charge_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="requested_qty"/>
                            <field name="issued_qty" readonly="parent.state != 'draft'"/>
                            <field name="unit_price"/>
                            <field name="subtotal" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pharmacy_return_form_view" model="ir.ui.view">
        <field name="name">pharmacy.requisition.return.form</field>
        <field name="model">pharmacy.requisition</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Medicine Return">
                <header>
                    <button name="action_return" type="object" string="Validate Return"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="leih_pharmacy.group_pharmacy_dispenser"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="doc_type" invisible="1"/>
                    <group>
                        <group>
                            <field name="admission_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="patient_id"/>
                            <field name="requested_by" string="Returned By (Nurse)"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="location_id" string="Return To Location"
                                   readonly="state != 'draft'"/>
                            <field name="net_amount" string="Credited to Bill"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id" string="Medicine"/>
                            <field name="returnable_qty" readonly="1"
                                   string="Returnable"/>
                            <field name="returned_qty" string="Return Qty"/>
                            <field name="unit_price"/>
                            <field name="subtotal" readonly="1" sum="Credit"/>
                            <field name="requested_qty" column_invisible="1"/>
                            <field name="issued_qty" column_invisible="1"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        <i class="fa fa-info-circle"/>
                        Returnable is everything issued for this medicine across all of
                        the admission's requisitions, less what has already been returned.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pharmacy_return_list_view" model="ir.ui.view">
        <field name="name">pharmacy.requisition.return.list</field>
        <field name="model">pharmacy.requisition</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="admission_id"/>
                <field name="patient_id"/>
                <field name="net_amount" string="Credited" sum="Credited"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="pharmacy_return_action" model="ir.actions.act_window">
        <field name="name">Medicine Returns</field>
        <field name="res_model">pharmacy.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doc_type','=','return')]</field>
        <field name="context">{'default_doc_type': 'return'}</field>
        <field name="search_view_id" ref="pharmacy_requisition_search_view"/>
    </record>

    <record id="pharmacy_return_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="pharmacy_return_list_view"/>
        <field name="act_window_id" ref="pharmacy_return_action"/>
    </record>

    <record id="pharmacy_return_action_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="pharmacy_return_form_view"/>
        <field name="act_window_id" ref="pharmacy_return_action"/>
    </record>

    <record id="pharmacy_requisition_search_view" model="ir.ui.view">
        <field name="name">pharmacy.requisition.search</field>
        <field name="model">pharmacy.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="admission_id"/>
                <field name="patient_id"/>
                <filter name="draft" string="Pending (to issue)" domain="[('state','=','draft')]"/>
                <filter name="issued" string="Issued" domain="[('state','=','issued')]"/>
                <separator/>
                <filter name="doc_issue" string="Issues" domain="[('doc_type','=','issue')]"/>
                <filter name="doc_return" string="Returns" domain="[('doc_type','=','return')]"/>
                <separator/>
                <filter name="group_admission" string="Admission" context="{'group_by':'admission_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="pharmacy_requisition_action" model="ir.actions.act_window">
        <field name="name">Pharmacy Requisitions</field>
        <field name="res_model">pharmacy.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doc_type','=','issue')]</field>
        <field name="context">{'default_doc_type': 'issue'}</field>
        <field name="search_view_id" ref="pharmacy_requisition_search_view"/>
    </record>

    <record id="pharmacy_requisition_pending_action" model="ir.actions.act_window">
        <field name="name">Pending Requisitions</field>
        <field name="res_model">pharmacy.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pharmacy_requisition_search_view"/>
        <field name="domain">[('state','=','draft'),('doc_type','=','issue')]</field>
    </record>
</odoo>
