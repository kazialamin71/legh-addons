<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hospital_admission_form_pharmacy" model="ir.ui.view">
        <field name="name">hospital.admission.form.pharmacy</field>
        <field name="model">hospital.admission</field>
        <field name="inherit_id" ref="leih19.hospital_admission_form_view"/>
        <field name="arch" type="xml">
            <button name="btn_bill" position="after">
                <field name="pharmacy_requisition_count" invisible="1"/>
                <button string="New Pharmacy Requisition" type="object"
                        name="action_new_pharmacy_requisition" class="btn-secondary"
                        groups="base.group_user"/>
                <button string="Return Medicine" type="object"
                        name="action_new_pharmacy_return" class="btn-secondary"
                        invisible="medicine_issued_total == 0"
                        groups="base.group_user"/>
                <button string="Pharmacy Requisitions" type="object"
                        name="action_view_pharmacy_requisitions" class="btn-secondary"
                        invisible="pharmacy_requisition_count == 0"/>
                <button string="Medicine Statement" type="object"
                        name="action_print_medicine_statement" class="btn-secondary"
                        invisible="pharmacy_requisition_count == 0"/>
            </button>

            <!-- Issued, returned and the adjusted figure that is actually billed. -->
            <xpath expr="//separator[@name='manual_medicine']" position="before">
                <separator string="Medicine Issued"/>
                <field name="pharmacy_issue_ids" readonly="1" nolabel="1">
                    <list>
                        <field name="date"/>
                        <field name="name" string="Requisition No"/>
                        <field name="net_amount" string="Amount" sum="Issued"/>
                        <field name="state"/>
                    </list>
                </field>

                <separator string="Medicine Returned"/>
                <field name="pharmacy_return_ids" readonly="1" nolabel="1">
                    <list>
                        <field name="date"/>
                        <field name="name" string="Return No"/>
                        <field name="net_amount" string="Credited" sum="Returned"/>
                        <field name="state"/>
                    </list>
                </field>

                <group class="oe_subtotal_footer" name="medicine_totals">
                    <field name="medicine_issued_total" readonly="1"/>
                    <field name="medicine_returned_total" readonly="1"/>
                    <field name="medicine_adjusted_total" readonly="1"
                           class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
