<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_bed_line_list_indoor" model="ir.ui.view">
        <field name="name">hospital.bed.line.list.indoor</field>
        <field name="model">hospital.bed.line</field>
        <field name="arch" type="xml">
            <list string="Accommodation History" decoration-info="is_current==True">
                <field name="hospital_bed_item_id"/>
                <field name="category_id"/>
                <field name="ward_id"/>
                <field name="bed_no"/>
                <field name="bed_state" widget="badge"
                       decoration-success="bed_state == 'available'"
                       decoration-danger="bed_state == 'occupied'"
                       decoration-warning="bed_state == 'reserved'"
                       decoration-muted="bed_state == 'maintenance'"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_count"/>
                <field name="perday_charge"/>
                <field name="total_amount" sum="Total"/>
                <field name="manual_override"/>
                <field name="shift_reason"/>
                <field name="is_current" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_bed_line_form_indoor" model="ir.ui.view">
        <field name="name">hospital.bed.line.form.indoor</field>
        <field name="model">hospital.bed.line</field>
        <field name="arch" type="xml">
            <form string="Accommodation Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="hospital_bed_item_id"/>
                            <field name="category_id" readonly="1"/>
                            <field name="ward_id" readonly="1"/>
                            <field name="bed_no"/>
                            <field name="bed_state"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="bed_qty"/>
                            <field name="perday_charge"/>
                            <field name="days_count" readonly="1"/>
                            <field name="manual_override"/>
                            <field name="total_amount"/>
                            <field name="shift_reason"/>
                            <field name="is_current" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_bed_line_indoor" model="ir.actions.act_window">
        <field name="name">Accommodation Entries</field>
        <field name="res_model">hospital.bed.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
