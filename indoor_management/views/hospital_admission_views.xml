<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hospital_admission_form_view_indoor" model="ir.ui.view">
        <field name="name">hospital.admission.form.indoor</field>
        <field name="model">hospital.admission</field>
        <field name="inherit_id" ref="leih19.hospital_admission_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_view_prescriptions']" position="after">
                <button string="Shift Bed" type="object" name="action_shift_bed"
                        class="btn-secondary"
                        invisible="state != 'activated'"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="indoor_button_box">
                    <button name="action_view_accommodation" type="object"
                            class="oe_stat_button" icon="fa-bed">
                        <field name="bed_line_count" widget="statinfo" string="Accommodations"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//field[@name='hospital_bed_line_id']" position="replace">
                <field name="hospital_bed_line_id">
                    <list editable="bottom"
                          decoration-info="is_current==True"
                          decoration-muted="bed_state == 'maintenance'">
                        <field name="category_id" readonly="1"/>
                        <field name="ward_id" readonly="1"/>
                        <field name="bed_no" options="{'no_create': True}"/>
                        <field name="bed_state" widget="badge"
                               decoration-success="bed_state == 'available'"
                               decoration-danger="bed_state == 'occupied'"
                               decoration-warning="bed_state == 'reserved'"
                               decoration-muted="bed_state == 'maintenance'"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="bed_qty"/>
                        <field name="perday_charge"/>
                        <field name="days_count" readonly="1"/>
                        <field name="manual_override"/>
                        <field name="total_amount"/>
                        <field name="shift_reason"/>
                        <field name="is_current" column_invisible="True"/>
                    </list>
                </field>
            </xpath>

            <!-- "Where is this patient?" is asked far more often than anything
                 else on this form, so it is answered in one line at the top and
                 leads straight to the bed and to the rest of the ward, rather
                 than being three read-only boxes halfway down. -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info d-flex align-items-center flex-wrap gap-2 mb-0"
                     role="status" invisible="not current_bed_id">
                    <i class="fa fa-bed me-1" title="Current location"/>
                    <strong class="me-2"><field name="current_location" readonly="1" nolabel="1"/></strong>
                    <button name="action_open_current_bed" type="object"
                            class="btn btn-sm btn-secondary" icon="fa-arrow-right"
                            string="Open Bed"/>
                    <button name="action_open_current_ward" type="object"
                            class="btn btn-sm btn-secondary" icon="fa-th"
                            string="See the Ward"/>
                    <button name="action_shift_bed" type="object"
                            class="btn btn-sm btn-primary" icon="fa-exchange"
                            string="Shift Bed" invisible="state != 'activated'"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="current_bed_id or state != 'activated'">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    This patient is admitted but has <b>no bed assigned</b>, so they
                    will not appear on the ward board and no bed charge can be raised.
                </div>
            </xpath>

            <xpath expr="//field[@name='admitting_doctor']" position="after">
                <field name="current_category_id" readonly="1"/>
                <field name="current_ward_id" readonly="1"/>
                <field name="current_bed_id" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>
