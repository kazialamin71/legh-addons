<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_ward_list" model="ir.ui.view">
        <field name="name">hospital.ward.list</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <list string="Wards / Rooms">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="perday_charge"/>
                <field name="bed_count"/>
                <field name="available_bed_count"/>
                <field name="occupied_bed_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_ward_form" model="ir.ui.view">
        <field name="name">hospital.ward.form</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <form string="Ward / Room">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="code"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="perday_charge"/>
                            <field name="bed_count"/>
                            <field name="available_bed_count"/>
                            <field name="occupied_bed_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beds">
                            <field name="bed_ids" context="{'default_ward_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="perday_charge"/>
                                    <field name="state"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_ward" model="ir.actions.act_window">
        <field name="name">Wards / Rooms</field>
        <field name="res_model">hospital.ward</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
