<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_bed_transfer_form" model="ir.ui.view">
        <field name="name">hospital.bed.transfer.form</field>
        <field name="model">hospital.bed.transfer</field>
        <field name="arch" type="xml">
            <form string="Shift Bed">
                <sheet>
                    <group string="Patient / Current Accommodation">
                        <group>
                            <field name="admission_id" readonly="1"/>
                            <field name="patient_name" readonly="1"/>
                            <field name="current_bed_line_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_category_id" readonly="1"/>
                            <field name="current_ward_id" readonly="1"/>
                            <field name="current_bed_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Shift To">
                        <group>
                            <field name="new_category_id"/>
                            <field name="new_ward_id"/>
                            <field name="new_bed_id"/>
                            <field name="new_bed_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="shift_datetime"/>
                            <field name="override_charge"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <field name="new_bed_warning" readonly="1" invisible="not new_bed_warning"/>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Shift" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
