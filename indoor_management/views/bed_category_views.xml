<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bed_category_list" model="ir.ui.view">
        <field name="name">bed.category.list</field>
        <field name="model">bed.category</field>
        <field name="arch" type="xml">
            <list string="Bed Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="perday_charge"/>
                <field name="bed_count"/>
                <field name="available_bed_count"/>
                <field name="occupied_bed_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bed_category_form" model="ir.ui.view">
        <field name="name">bed.category.form</field>
        <field name="model">bed.category</field>
        <field name="arch" type="xml">
            <form string="Bed Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="perday_charge"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                            <field name="bed_count"/>
                            <field name="available_bed_count"/>
                            <field name="occupied_bed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Wards">
                            <field name="ward_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="floor"/>
                                    <field name="capacity"/>
                                    <field name="bed_count"/>
                                    <field name="available_bed_count"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bed_category" model="ir.actions.act_window">
        <field name="name">Bed Categories</field>
        <field name="res_model">bed.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
