<?xml version="1.0" encoding="UTF-8"?>
<!--
    Antibiotics used on antibiograms, grouped by drug class so the sensitivity
    panel prints in a clinically sensible order rather than alphabetically.

    leih19 already ships 19 first-line agents (lab_antibiotic_data.xml); this
    file adds the rest that the legacy export listed, and re-sequences the
    existing ones into the same class-ordered scheme.

    Note the legacy export stored these as `examination.entry.line` components,
    which meant a sensitivity result could not record zone diameter or an
    S/I/R interpretation. Microbiology tests here use `antibiotic_ids` instead,
    which feeds examination.result.antibiogram.line.
-->
<odoo noupdate="1">

    <!-- ==================== re-sequence leih19's agents =================== -->
    <record id="leih19.antibiotic_ampicillin" model="lab.antibiotic"><field name="sequence">10</field></record>
    <record id="leih19.antibiotic_amoxicillin" model="lab.antibiotic"><field name="sequence">20</field></record>
    <record id="leih19.antibiotic_amoxiclav" model="lab.antibiotic"><field name="sequence">50</field></record>
    <record id="leih19.antibiotic_piptaz" model="lab.antibiotic"><field name="sequence">60</field></record>
    <record id="leih19.antibiotic_cefuroxime" model="lab.antibiotic"><field name="sequence">110</field></record>
    <record id="leih19.antibiotic_ceftriaxone" model="lab.antibiotic"><field name="sequence">130</field></record>
