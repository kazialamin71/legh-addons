<?xml version="1.0" encoding="UTF-8"?>
<!--
    One income account per diagnostic / service department.

    Every catalogue item points at the account for its department, so the
    general ledger yields a department-wise revenue breakdown with no extra
    reporting layer. leih_accounting._income_account() reads the item's
    accounts_id first and only falls back to the configured default, so these
    accounts are what actually gets credited when a bill is posted.

    Codes sit in the 4011xx-4019xx block, clear of the l10n_bd chart's own
    401xx sales accounts.
-->
<odoo noupdate="1">

    <!-- ============================ PATHOLOGY ============================ -->
    <record id="account_income_biochemistry" model="account.account">
        <field name="code">401101</field>
        <field name="name">Diagnostic Income - Biochemistry</field>
        <field name="account_type">income</field>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
    </record>

