<?xml version="1.0" encoding="UTF-8"?>
<!--
    Narrative report templates for imaging and descriptive studies.

    A test with `report_layout = 'narrative'` prints `narrative_html` from the
    result. Free-typing that body for every scan is how reports drift: one
    sonologist reports liver span, the next does not. These templates give each
    study a fixed skeleton with the measurements spelled out, so the operator
    fills blanks instead of recalling the structure.

    Templates are attached to tests via `report_template_ids`; the technician
    picks one on the result and edits the loaded copy.
-->
<odoo noupdate="1">

    <record id="tpl_usg_whole_abdomen" model="examination.report.template">
        <field name="name">USG of Whole Abdomen</field>
        <field name="report_type">descriptive</field>
        <field name="department" ref="dept_usg"/>
        <field name="body_html" type="html">
            <div>
                <p><b>LIVER:</b> Normal in size (span ____ cm), shape and echotexture. No focal lesion. Intrahepatic biliary channels are not dilated. Portal vein measures ____ mm.</p>
                <p><b>GALL BLADDER:</b> Well distended, wall thickness ____ mm. No calculus or sludge seen.</p>
                <p><b>COMMON BILE DUCT:</b> Not dilated, measures ____ mm.</p>
                <p><b>PANCREAS:</b> Normal in size and echotexture. Pancreatic duct is not dilated.</p>
                <p><b>SPLEEN:</b> Normal in size (____ cm) and echotexture. No focal lesion.</p>
                <p><b>RIGHT KIDNEY:</b> Measures ____ x ____ cm. Normal cortical echogenicity, corticomedullary differentiation maintained. No calculus or hydronephrosis.</p>
                <p><b>LEFT KIDNEY:</b> Measures ____ x ____ cm. Normal cortical echogenicity, corticomedullary differentiation maintained. No calculus or hydronephrosis.</p>
                <p><b>URINARY BLADDER:</b> Well distended, wall thickness normal. No calculus or mass. Pre-void volume ____ mL, post-void residue ____ mL.</p>
                <p><b>PROSTATE / UTERUS &amp; ADNEXA:</b> ____</p>
                <p><b>OTHERS:</b> No free fluid in the peritoneal cavity. No significant lymphadenopathy.</p>
                <p><b>IMPRESSION:</b> ____</p>
            </div>
        </field>
    </record>

