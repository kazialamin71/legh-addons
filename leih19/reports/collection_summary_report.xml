<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Optics Collection Report (date range) -->
    <record id="action_report_optics_daily_collection" model="ir.actions.report">
        <field name="name">Optics Collection Report</field>
        <field name="model">optics.daily.collection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_optics_daily_collection_document</field>
        <field name="report_file">leih19.report_optics_daily_collection_document</field>
        <field name="print_report_name">'Optics Collection'</field>
        <field name="binding_model_id" ref="leih19.model_optics_daily_collection"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_optics_daily_collection_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>
                        <h2 class="doc_title">OPTICS COLLECTION REPORT</h2>
                        <div class="doc_sub">
                            <span t-field="o.date_start" t-options="{'widget': 'date'}"/>
                            &#8594;
                            <span t-field="o.date_end" t-options="{'widget': 'date'}"/>
                        </div>

                        <t t-set="sales" t-value="o._collection_sales()"/>
                        <t t-set="tot" t-value="o._collection_totals()"/>

                        <table class="items">
                            <thead>
                                <tr>
                                    <th style="width:6%">#</th>
                                    <th style="width:16%">Date</th>
                                    <th style="width:18%">Invoice</th>
                                    <th style="width:26%">Patient</th>
                                    <th style="width:12%" class="num">Total</th>
                                    <th style="width:11%" class="num">Paid</th>
                                    <th style="width:11%" class="num">Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="sales" t-as="s">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr>
                                        <td class="ctr"><span t-out="idx"/></td>
                                        <td><span t-field="s.date" t-options="{'widget': 'date'}"/></td>
                                        <td><span t-out="s.name or '-'"/></td>
                                        <td><span t-out="s.patient_name.name or '-'"/></td>
                                        <td class="num"><span t-out="'%.2f' % (s.grand_total or 0)"/></td>
                                        <td class="num"><span t-out="'%.2f' % (s.paid or 0)"/></td>
                                        <td class="num"><span t-out="'%.2f' % (s.due or 0)"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not sales">
                                    <td colspan="7" class="ctr text-muted">No optics sales in this period.</td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="totals">
                            <tr><td>Sales Count</td>
                                <td class="num"><span t-out="tot['count']"/></td></tr>
                            <tr><td>Total Billed</td>
                                <td class="num"><span t-out="'%.2f' % tot['grand_total']"/></td></tr>
                            <tr class="grand"><td>Total Collected</td>
                                <td class="num"><span t-out="'%.2f' % tot['paid']"/></td></tr>
                            <tr class="due"><td>Total Due</td>
                                <td class="num"><span t-out="'%.2f' % tot['due']"/></td></tr>
                        </table>

                        <div class="sign_row" style="display:flex; justify-content:space-between;">
                            <span class="sign_box">Prepared By</span>
                            <span class="sign_box">Accounts</span>
                        </div>
                        <p class="foot_note">*** Computer-generated collection report. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- CC (Consolidated) Collection Report (date range) -->
    <record id="action_report_cc_collection" model="ir.actions.report">
        <field name="name">CC Collection Report</field>
        <field name="model">cc.collection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_cc_collection_document</field>
        <field name="report_file">leih19.report_cc_collection_document</field>
        <field name="print_report_name">'CC Collection'</field>
        <field name="binding_model_id" ref="leih19.model_cc_collection"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cc_collection_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>
                        <h2 class="doc_title">CC COLLECTION REPORT</h2>
                        <div class="doc_sub">
                            <span t-field="o.date_start" t-options="{'widget': 'date'}"/>
                            &#8594;
                            <span t-field="o.date_end" t-options="{'widget': 'date'}"/>
                        </div>

                        <t t-set="rows" t-value="o._cc_summary()"/>
                        <t t-set="total" t-value="o._cc_total()"/>

                        <table class="items">
                            <thead>
                                <tr>
                                    <th style="width:60%">Collection Source</th>
                                    <th style="width:20%" class="num">Receipts</th>
                                    <th style="width:20%" class="num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <tr>
                                        <td><span t-out="row['label']"/></td>
                                        <td class="num"><span t-out="row['count']"/></td>
                                        <td class="num"><span t-out="'%.2f' % row['amount']"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not rows">
                                    <td colspan="3" class="ctr text-muted">No collections in this period.</td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="totals">
                            <tr class="grand"><td>Grand Total Collection</td>
                                <td class="num"><span t-out="'%.2f' % total"/></td></tr>
                        </table>

                        <div class="sign_row" style="display:flex; justify-content:space-between;">
                            <span class="sign_box">Prepared By</span>
                            <span class="sign_box">Accounts</span>
                        </div>
                        <p class="foot_note">*** Consolidated from confirmed money receipts. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
