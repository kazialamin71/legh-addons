<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_opd_ticket" model="ir.actions.report">
        <field name="name">OPD Ticket</field>
        <field name="model">opd.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_opd_ticket_document</field>
        <field name="report_file">leih19.report_opd_ticket_document</field>
        <field name="print_report_name">'OPD Ticket - %s' % (object.name or object.patient_name.name)</field>
        <field name="binding_model_id" ref="leih19.model_opd_ticket"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_opd_ticket_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>

                        <h2 class="doc_title">OPD TICKET</h2>

                        <table class="meta">
                            <tr>
                                <td style="width:40%"><span class="lbl">Patient</span>
                                    <span t-field="o.patient_name"/></td>
                                <td style="width:30%"><span class="lbl">Patient ID</span>
                                    <span t-out="o.patient_id or '-'"/></td>
                                <td style="width:30%"><span class="lbl">Ticket No</span>
                                    <span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Age / Sex</span>
                                    <span t-out="o.age or '-'"/> / <span t-out="o.sex or '-'"/></td>
                                <td><span class="lbl">Mobile</span>
                                    <span t-out="o.mobile or '-'"/></td>
                                <td><span class="lbl">Date</span>
                                    <span t-field="o.date" t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr>
                                <td colspan="2"><span class="lbl">Address</span>
                                    <span t-out="o.address or '-'"/></td>
                                <td><span class="lbl">Referred by</span>
                                    <span t-out="o.ref_doctors.name or '-'"/></td>
                            </tr>
                        </table>

                        <table class="items">
                            <thead>
                                <tr>
                                    <th style="width:8%">#</th>
                                    <th style="width:52%">Consultation / Item</th>
                                    <th style="width:20%">Department</th>
                                    <th style="width:20%" class="num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.opd_ticket_line_id" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr>
                                        <td class="ctr"><span t-out="idx"/></td>
                                        <td><span t-out="line.name.name or '-'"/></td>
                                        <td><span t-out="line.department or '-'"/></td>
                                        <td class="num"><span t-out="'%.2f' % (line.total_amount or 0)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="totals">
                            <tr class="grand"><td>Total</td>
                                <td class="num"><span t-out="'%.2f' % o.total"/></td></tr>
                        </table>

                        <div class="sign_row" style="text-align:right;">
                            <span class="sign_box">Authorized Signature</span>
                        </div>

                        <p class="foot_note">*** Computer-generated OPD ticket. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
