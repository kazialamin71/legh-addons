<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A real card, not an A4 page with a card drawn on it: 85 x 53 mm is the
         standard ID size, and printing it at that size is what lets it come out
         of a card printer or be guillotined without measuring. -->
    <record id="paperformat_patient_id_card" model="report.paperformat">
        <field name="name">Patient ID Card 85x53mm</field>
        <field name="format">custom</field>
        <field name="page_width">85</field>
        <field name="page_height">53</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_patient_id_card" model="ir.actions.report">
        <field name="name">Patient ID Card</field>
        <field name="model">patient.info</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_patient_id_card</field>
        <field name="report_file">leih19.report_patient_id_card</field>
        <field name="print_report_name">'Patient ID Card - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_patient_id_card"/>
    </record>

    <template id="report_patient_id_card">
        <t t-call="web.basic_layout">
            <style>
                /* Qt WebKit lays this page out at roughly 120 CSS dpi, not the
                   96 the docs imply, so 85mm is about 403px wide and not 321.
                   Measured off a rendered card rather than assumed. The outer
                   box uses 100% so it fills the page whatever that mapping is;
                   the insides are px tuned to that ~403px viewport. The height
                   is deliberately a few px under the page: a card box even a
                   fraction taller spills into a second, blank page, so every
                   card printed comes out as two. Do not reintroduce mm or pt --
                   physical units and type scale by different factors here and
                   the layout drifts off the card. */
                @page { margin:0; }
                html, body { margin:0 !important; padding:0 !important; }
                #wrapwrap, #wrapwrap > main, .article, .page,
                div.header, div.footer { margin:0 !important; padding:0 !important; }
                div.header, div.footer { display:none !important; }
                .pidcard, .pidcard * { box-sizing:border-box; }
                /* Reset the cells only. Including `table` here killed the
                   header's own border-bottom -- the !important beat the inline
                   style and the rule under the hospital name silently vanished. */
                .pidcard tr, .pidcard td
                    { border:0 none !important; margin:0; padding:0; }
                .pidcard table { margin:0; padding:0; border-collapse:collapse; }
                .pidcard p { margin:0; padding:0; }
                .pidcard td { vertical-align:top; }
                .pidcard .lbl { font-size:9px; color:#444; width:43px;
                                padding:1px 0; white-space:nowrap; }
                .pidcard .val { font-size:11px; font-weight:bold; color:#000;
                                padding:1px 0; }
            </style>
            <t t-foreach="docs" t-as="o">
                <!-- patient.info carries no company of its own; res_company is
                     what the report engine puts in the context. -->
                <t t-set="company" t-value="res_company or o.env.company"/>
                <div class="pidcard"
                     style="width:100%; height:242px; padding:9px 10px; overflow:hidden;
                            font-family:Arial, Helvetica, sans-serif; color:#000;">

                    <!-- ================= 1. logo + hospital ================= -->
                    <table style="width:100%; border-bottom:1.5px solid #000;">
                        <tr>
                            <td t-if="company.logo" style="width:45px; padding-bottom:5px;">
                                <img t-att-src="image_data_uri(company.logo)"
                                     style="width:40px; height:40px; object-fit:contain;"/>
                            </td>
                            <td style="padding-bottom:5px; padding-left:8px;">
                                <div style="font-size:15px; font-weight:bold; line-height:1.15;">
                                    <span t-out="company.name"/>
                                </div>
                                <div t-if="company.street"
                                     style="font-size:8px; color:#444; line-height:1.2;">
                                    <span t-out="company.street"/><t t-if="company.city">, <span t-out="company.city"/></t>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- ========= 2. details left, photo right =========
                         A table, not flexbox: Qt WebKit has no flex support and
                         would stack these one above the other. -->
                    <table style="width:100%; margin-top:6px;">
                        <tr>
                            <td style="padding-right:8px;">
                                <table style="width:100%;">
                                    <tr><td class="lbl">ID</td>
                                        <td class="val"><span t-out="o.patient_id or '-'"/></td></tr>
                                    <tr><td class="lbl">Name</td>
                                        <td class="val"><span t-out="o.name or '-'"/></td></tr>
                                    <tr><td class="lbl">Age</td>
                                        <td class="val"><span t-out="o.age or '-'"/></td></tr>
                                    <tr><td class="lbl">Sex</td>
                                        <td class="val"><t t-if="o.sex"><span t-field="o.sex"/></t><t t-else="">-</t></td></tr>
                                    <tr t-if="o.mobile"><td class="lbl">Mobile</td>
                                        <td class="val"><span t-out="o.mobile"/></td></tr>
                                </table>
                            </td>
                            <td style="width:86px;">
                                <img t-if="o.photo" t-att-src="image_data_uri(o.photo)"
                                     style="width:83px; height:100px; object-fit:cover;
                                            border:1px solid #000;"/>
                                <div t-else=""
                                     style="width:83px; height:100px; border:1px solid #000;
                                            font-size:9px; color:#888; text-align:center;
                                            padding-top:44px;">No Photo</div>
                            </td>
                        </tr>
                    </table>

                    <!-- ======= 3. barcode of the patient id, date beneath ======= -->
                    <div style="text-align:center; margin-top:5px;">
                        <img t-if="o.patient_id" t-att-src="o._id_card_barcode_uri()"
                             style="width:238px; height:33px;"/>
                        <div style="font-size:9px; letter-spacing:1px; line-height:1.1;">
                            <span t-out="o.patient_id or ''"/>
                        </div>
                        <div style="font-size:8px; color:#444; line-height:1.2; margin-top:2px;">
                            Printed <span t-esc="datetime.datetime.now().strftime('%d-%m-%Y')"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
