<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_appointment_payment" model="ir.actions.report">
        <field name="name">Appointment Payment Statement</field>
        <field name="model">appointment.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_appointment_payment_document</field>
        <field name="report_file">leih19.report_appointment_payment_document</field>
        <field name="print_report_name">'Appointment Payment - %s' % (object.ref_doctors.name or object.id)</field>
        <field name="binding_model_id" ref="leih19.model_appointment_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_appointment_payment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>
                        <h2 class="doc_title">APPOINTMENT PAYMENT STATEMENT</h2>

                        <table class="meta">
                            <tr>
                                <td style="width:40%"><span class="lbl">Doctor</span>
                                    <span t-out="o.ref_doctors.name or '-'"/></td>
                                <td style="width:30%"><span class="lbl">From</span>
                                    <span t-field="o.cal_st_date" t-options="{'widget': 'date'}"/></td>
                                <td style="width:30%"><span class="lbl">To</span>
                                    <span t-field="o.cal_end_date" t-options="{'widget': 'date'}"/></td>
                            </tr>
                        </table>

                        <table class="items">
                            <thead>
                                <tr>
                                    <th style="width:6%">#</th>
                                    <th style="width:28%">Appointment</th>
                                    <th style="width:34%">Patient</th>
                                    <th style="width:16%">Type</th>
                                    <th style="width:16%" class="num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.appointment_payment_line_ids" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr>
                                        <td class="ctr"><span t-out="idx"/></td>
                                        <td><span t-out="line.appointment_booking_id or '-'"/></td>
                                        <td><span t-out="line.patient_name or '-'"/></td>
                                        <td><span t-out="line.patient_status or '-'"/></td>
                                        <td class="num"><span t-out="'%.2f' % (line.amount or 0)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="totals">
                            <tr class="grand"><td>Total Payable</td>
                                <td class="num"><span t-out="'%.2f' % o.total_payable_amount"/></td></tr>
                        </table>

                        <div class="sign_row" style="display:flex; justify-content:space-between;">
                            <span class="sign_box">Prepared By</span>
                            <span class="sign_box">Doctor</span>
                        </div>
                        <p class="foot_note">*** Computer-generated statement. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
