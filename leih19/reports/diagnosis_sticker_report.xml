<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_diagnosis_sticker" model="ir.actions.report">
        <field name="name">Diagnosis Sticker</field>
        <field name="model">diagnosis.sticker</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_diagnosis_sticker_document</field>
        <field name="report_file">leih19.report_diagnosis_sticker_document</field>
        <field name="print_report_name">'Sticker - %s' % (object.name or object.id)</field>
        <field name="binding_model_id" ref="leih19.model_diagnosis_sticker"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_diagnosis_sticker_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>
                        <h2 class="doc_title">DIAGNOSIS REPORT</h2>
                        <div class="doc_sub"><span t-out="o.test_id.name or ''"/></div>

                        <table class="meta">
                            <tr>
                                <td style="width:34%"><span class="lbl">Report No</span>
                                    <span t-out="o.name or '-'"/></td>
                                <td style="width:33%"><span class="lbl">Patient</span>
                                    <span t-out="o.full_name or '-'"/></td>
                                <td style="width:33%"><span class="lbl">Department</span>
                                    <span t-out="o.department_id or '-'"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Test</span>
                                    <span t-out="o.test_id.name or '-'"/></td>
                                <td><span class="lbl">Checked By</span>
                                    <span t-out="o.doctor_id.name or '-'"/></td>
                                <td><span class="lbl">Status</span>
                                    <span class="badge" t-out="dict(o._fields['state'].selection).get(o.state, o.state or '-')"/></td>
                            </tr>
                        </table>

                        <table class="items" t-if="o.sticker_line_id">
                            <thead>
                                <tr>
                                    <th style="width:40%">Parameter</th>
                                    <th style="width:25%">Result</th>
                                    <th style="width:25%">Reference</th>
                                    <th style="width:10%">Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.sticker_line_id" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-att-style="'font-weight:700;' if line.bold else ''"
                                                  t-out="line.test_name or '-'"/>
                                        </td>
                                        <td><span t-att-style="'font-weight:700;' if line.bold else ''"
                                                  t-out="line.result or '-'"/></td>
                                        <td><span t-out="line.ref_value or '-'"/></td>
                                        <td><span t-out="line.remarks or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="sign_row" style="text-align:right;">
                            <span class="sign_box">
                                <span t-out="o.doctor_id.name or ''"/><br/>Authorized Signature</span>
                        </div>
                        <p class="foot_note">*** This report is for medical reference only. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
