<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_admission_payment" model="ir.actions.report">
        <field name="name">Admission Payment Receipt</field>
        <field name="model">admission.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_admission_payment_document</field>
        <field name="report_file">leih19.report_admission_payment_document</field>
        <field name="print_report_name">'Admission Payment - %s' % (object.name or object.id)</field>
        <field name="binding_model_id" ref="leih19.model_admission_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_admission_payment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>
                        <h2 class="doc_title">ADMISSION PAYMENT RECEIPT</h2>

                        <t t-set="patient" t-value="o.admission_id.patient_name"/>
                        <table class="meta">
                            <tr>
                                <td style="width:34%"><span class="lbl">Receipt No</span>
                                    <span t-out="o.name or '-'"/></td>
                                <td style="width:33%"><span class="lbl">Admission</span>
                                    <span t-out="o.admission_id.name or '-'"/></td>
                                <td style="width:33%"><span class="lbl">Date</span>
                                    <span t-field="o.date" t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Patient</span>
                                    <span t-out="patient.name if patient else '-'"/></td>
                                <td><span class="lbl">Payment Type</span>
                                    <span t-out="o.payment_type.name if o.payment_type else '-'"/></td>
                                <td><span class="lbl">Money Receipt</span>
                                    <span t-out="o.money_receipt_id.name if o.money_receipt_id else '-'"/></td>
                            </tr>
                        </table>

                        <table class="totals" style="width:55%;">
                            <tr t-if="o.service_charge"><td>Service Charge</td>
                                <td class="num"><span t-out="'%.2f' % o.service_charge"/></td></tr>
                            <tr class="grand"><td>Received Amount</td>
                                <td class="num"><span t-out="'%.2f' % o.amount"/></td></tr>
                        </table>

                        <div class="sign_row" style="display:flex; justify-content:space-between;">
                            <span class="sign_box">Received By</span>
                            <span class="sign_box">Authorized Signature</span>
                        </div>
                        <p class="foot_note">*** Please preserve this receipt. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
