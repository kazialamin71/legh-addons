<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_leih_admission" model="ir.actions.report">
        <field name="name">Admission Bill</field>
        <field name="model">leih.admission</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leih19.report_leih_admission_document</field>
        <field name="report_file">leih19.report_leih_admission_document</field>
        <field name="print_report_name">'Admission Bill - %s' % (object.name or object.patient_name.name)</field>
        <field name="binding_model_id" ref="leih19.model_leih_admission"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_leih_admission_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page leih">
                        <t t-call="leih19.leih_report_styles"/>

                        <h2 class="doc_title">ADMISSION BILL</h2>
                        <div class="doc_sub">
                            <t t-if="o.emergency">Emergency</t>
                            <t t-else="">In-Patient</t>
                        </div>

                        <table class="meta">
                            <tr>
                                <td style="width:40%"><span class="lbl">Patient</span>
                                    <span t-field="o.patient_name"/></td>
                                <td style="width:30%"><span class="lbl">Patient ID</span>
                                    <span t-out="o.patient_id or '-'"/></td>
                                <td style="width:30%"><span class="lbl">Admission No</span>
                                    <span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Age / Sex</span>
                                    <span t-out="o.age or '-'"/> / <span t-out="o.sex or '-'"/></td>
                                <td><span class="lbl">Mobile</span>
                                    <span t-out="o.mobile or '-'"/></td>
                                <td><span class="lbl">Date</span>
                                    <span t-field="o.date" t-options="{'widget': 'datetime'}"/></td>
                            </tr>
                            <tr>
                                <td><span class="lbl">Admitting Doctor</span>
                                    <span t-out="o.admitting_doctor.name or o.ref_doctors.name or '-'"/></td>
                                <td><span class="lbl">Bed</span>
                                    <span t-out="o.bed or '-'"/></td>
                                <td><span class="lbl">Blood Group</span>
                                    <span t-out="o.blood_group or '-'"/></td>
                            </tr>
                            <tr t-if="o.clinic_diagnosis">
                                <td colspan="3"><span class="lbl">Clinical Diagnosis</span>
                                    <span t-out="o.clinic_diagnosis"/></td>
                            </tr>
                        </table>

                        <table class="items">
                            <thead>
                                <tr>
                                    <th style="width:6%">#</th>
                                    <th style="width:44%">Service / Item</th>
                                    <th style="width:20%">Department</th>
                                    <th style="width:15%" class="num">Price</th>
                                    <th style="width:15%" class="num">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.leih_admission_line_id" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr>
                                        <td class="ctr"><span t-out="idx"/></td>
                                        <td><span t-out="line.name.name or '-'"/></td>
                                        <td><span t-out="line.department or '-'"/></td>
                                        <td class="num"><span t-out="'%.2f' % (line.price or 0)"/></td>
                                        <td class="num"><span t-out="'%.2f' % (line.total_amount or 0)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="totals">
                            <tr><td>Gross Total</td>
                                <td class="num"><span t-out="'%.2f' % o.total_without_discount"/></td></tr>
                            <tr t-if="o.after_discount"><td>Discount
                                (<span t-out="'%g' % o.doctors_discounts"/>%)</td>
                                <td class="num"><span t-out="'-%.2f' % o.after_discount"/></td></tr>
                            <tr t-if="o.other_discount"><td>Other Discount</td>
                                <td class="num"><span t-out="'-%.2f' % o.other_discount"/></td></tr>
                            <tr class="grand"><td>Grand Total</td>
                                <td class="num"><span t-out="'%.2f' % o.grand_total"/></td></tr>
                            <tr t-if="o.advance"><td>Advance</td>
                                <td class="num"><span t-out="'%.2f' % o.advance"/></td></tr>
                            <tr><td>Paid</td>
                                <td class="num"><span t-out="'%.2f' % o.paid"/></td></tr>
                            <tr class="due"><td>Due</td>
                                <td class="num"><span t-out="'%.2f' % o.due"/></td></tr>
                        </table>

                        <div class="sign_row" style="display:flex; justify-content:space-between;">
                            <span class="sign_box">Received By
                                <br/><span t-out="o.user_id.name or ''"/></span>
                            <span class="sign_box">Patient / Guarantor</span>
                        </div>

                        <p class="foot_note">*** Computer-generated admission bill. ***</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
