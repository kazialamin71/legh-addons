<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_paid_tree_view" model="ir.ui.view">
        <field name="name">appointment_paid.tree</field>
        <field name="model">appointment.paid</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_status" />
                <field name="amount" />
            </list>
        </field>
    </record>
    <record id="appointment_paid_form_view" model="ir.ui.view">
        <field name="name">appointment_paid.form</field>
        <field name="model">appointment.paid</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="patient_status" />
                        </group>
                        <group>
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="appointment_paid_action" model="ir.actions.act_window">
        <field name="name">appointment_paid</field>
        <field name="res_model">appointment.paid</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>