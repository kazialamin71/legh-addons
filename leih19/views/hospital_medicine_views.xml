<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hospital_medicine_tree_view" model="ir.ui.view">
        <field name="name">hospital_medicine.tree</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_name" />
                <field name="product_qty" />
                <field name="unit_price" />
                <field name="total_price" />
            </list>
        </field>
    </record>
    <record id="hospital_medicine_form_view" model="ir.ui.view">
        <field name="name">hospital_medicine.form</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="product_name" />
                            <field name="unit_price" />
                        </group>
                        <group>
                            <field name="product_qty" />
                            <field name="total_price" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_medicine_action" model="ir.actions.act_window">
        <field name="name">hospital_medicine</field>
        <field name="res_model">hospital.medicine</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>