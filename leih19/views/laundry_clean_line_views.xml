<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="laundry_clean_line_tree_view" model="ir.ui.view">
        <field name="name">laundry_clean_line.tree</field>
        <field name="model">laundry.clean.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="laundry_clean_id" />
                <field name="linen_item" />
                <field name="quantity" />
                <field name="color" />
            </list>
        </field>
    </record>
    <record id="laundry_clean_line_form_view" model="ir.ui.view">
        <field name="name">laundry_clean_line.form</field>
        <field name="model">laundry.clean.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="laundry_clean_id" />
                            <field name="quantity" />
                        </group>
                        <group>
                            <field name="linen_item" />
                            <field name="color" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="laundry_clean_line_action" model="ir.actions.act_window">
        <field name="name">laundry_clean_line</field>
        <field name="res_model">laundry.clean.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>