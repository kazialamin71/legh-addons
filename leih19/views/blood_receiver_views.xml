<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="blood_receiver_tree_view" model="ir.ui.view">
        <field name="name">blood_receiver.tree</field>
        <field name="model">blood.receiver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="buyer_name" />
                <field name="receive_date" />
                <field name="mobile_no" />
                <field name="patient_id" />
                <field name="description" />
                <field name="blood_group" />
                <field name="price" />
                <field name="paid_amount" />
                <field name="unpaid_amount" />
            </list>
        </field>
    </record>
    <record id="blood_receiver_form_view" model="ir.ui.view">
        <field name="name">blood_receiver.form</field>
        <field name="model">blood.receiver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="receive_date" />
                            <field name="patient_id" />
                            <field name="blood_group" />
                            <field name="paid_amount" />
                        </group>
                        <group>
                            <field name="buyer_name" />
                            <field name="mobile_no" />
                            <field name="description" />
                            <field name="price" />
                            <field name="unpaid_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="blood_receiver_action" model="ir.actions.act_window">
        <field name="name">blood_receiver</field>
        <field name="res_model">blood.receiver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>