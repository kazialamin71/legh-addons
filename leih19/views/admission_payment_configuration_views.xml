<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="admission_payment_configuration_tree_view" model="ir.ui.view">
        <field name="name">admission_payment_configuration.tree</field>
        <field name="model">admission.payment.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="doctor_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="overall_admission_rate" />
                <field name="overall_default_discount" />
                <field name="max_default_discount" />
                <field name="deduct_from_discount" />
                <field name="add_few_departments" />
                <field name="department_ids" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="admission_payment_configuration_form_view" model="ir.ui.view">
        <field name="name">admission_payment_configuration.form</field>
        <field name="model">admission.payment.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="start_date" />
                            <field name="overall_admission_rate" />
                            <field name="max_default_discount" />
                            <field name="add_few_departments" />
                        </group>
                        <group>
                            <field name="doctor_id" />
                            <field name="end_date" />
                            <field name="overall_default_discount" />
                            <field name="deduct_from_discount" />
                            <field name="department_ids" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Admission Configuration Line">
                            <field name="admission_configuration_line_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="admission_payment_configuration_action" model="ir.actions.act_window">
        <field name="name">admission_payment_configuration</field>
        <field name="res_model">admission.payment.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>