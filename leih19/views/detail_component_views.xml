<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="detail_component_tree_view" model="ir.ui.view">
        <field name="name">detail_component.tree</field>
        <field name="model">detail.component</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_start" />
                <field name="date_end" />
            </list>
        </field>
    </record>
    <record id="detail_component_form_view" model="ir.ui.view">
        <field name="name">detail_component.form</field>
        <field name="model">detail.component</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="date_start" />
                        </group>
                        <group>
                            <field name="date_end" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="detail_component_action" model="ir.actions.act_window">
        <field name="name">detail_component</field>
        <field name="res_model">detail.component</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>