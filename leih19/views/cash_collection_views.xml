<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="cash_collection_tree_view" model="ir.ui.view">
        <field name="name">cash_collection.tree</field>
        <field name="model">cash.collection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date" />
                <field name="type" />
                <field name="total" />
                <field name="journal_id" />
                <field name="debit_act_id" />
                <field name="credit_act_id" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="cash_collection_form_view" model="ir.ui.view">
        <field name="name">cash_collection.form</field>
        <field name="model">cash.collection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="type" />
                            <field name="journal_id" />
                            <field name="credit_act_id" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="total" />
                            <field name="debit_act_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Cash Collection Lines">
                            <field name="cash_collection_lines" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="cash_collection_action" model="ir.actions.act_window">
        <field name="name">cash_collection</field>
        <field name="res_model">cash.collection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>