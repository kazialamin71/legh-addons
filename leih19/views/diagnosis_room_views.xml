<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="diagnosis_room_tree_view" model="ir.ui.view">
        <field name="name">diagnosis_room.tree</field>
        <field name="model">diagnosis.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="room_no" />
                <field name="name" />
                <field name="floor" />
                <field name="building_name" />
            </list>
        </field>
    </record>
    <record id="diagnosis_room_form_view" model="ir.ui.view">
        <field name="name">diagnosis_room.form</field>
        <field name="model">diagnosis.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="room_no" />
                            <field name="floor" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="building_name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="diagnosis_room_action" model="ir.actions.act_window">
        <field name="name">diagnosis_room</field>
        <field name="res_model">diagnosis.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>