<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hospital_patient_guarantor_tree_view" model="ir.ui.view">
        <field name="name">hospital_patient_guarantor.tree</field>
        <field name="model">hospital.patient.guarantor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="address" />
                <field name="relationship" />
                <field name="contact" />
                <field name="email" />
                <field name="admission_id" />
            </list>
        </field>
    </record>
    <record id="hospital_patient_guarantor_form_view" model="ir.ui.view">
        <field name="name">hospital_patient_guarantor.form</field>
        <field name="model">hospital.patient.guarantor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="relationship" />
                            <field name="email" />
                        </group>
                        <group>
                            <field name="address" />
                            <field name="contact" />
                            <field name="admission_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_patient_guarantor_action" model="ir.actions.act_window">
        <field name="name">hospital_patient_guarantor</field>
        <field name="res_model">hospital.patient.guarantor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>