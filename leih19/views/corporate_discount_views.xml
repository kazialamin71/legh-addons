<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="corporate_discount_tree_view" model="ir.ui.view">
        <field name="name">corporate_discount.tree</field>
        <field name="model">corporate.discount</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="bill_id" />
                <field name="date" />
                <field name="corporate_id" />
                <field name="discount_amount" />
                <field name="total_amount" />
                <field name="period_id" />
                <field name="journal_id" />
                <field name="note" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="corporate_discount_form_view" model="ir.ui.view">
        <field name="name">corporate_discount.form</field>
        <field name="model">corporate.discount</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="date" />
                            <field name="discount_amount" />
                            <field name="period_id" />
                            <field name="note" />
                        </group>
                        <group>
                            <field name="bill_id" />
                            <field name="corporate_id" />
                            <field name="total_amount" />
                            <field name="journal_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="corporate_discount_action" model="ir.actions.act_window">
        <field name="name">corporate_discount</field>
        <field name="res_model">corporate.discount</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>