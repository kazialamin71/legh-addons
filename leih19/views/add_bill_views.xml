<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="add_bill_tree_view" model="ir.ui.view">
        <field name="name">add.bill.list</field>
        <field name="model">add.bill</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="price" />
                <field name="discount" />
                <field name="total_amount" />
            </list>
        </field>
    </record>
    <record id="add_bill_form_view" model="ir.ui.view">
        <field name="name">add.bill.form</field>
        <field name="model">add.bill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="discount" />
                        </group>
                        <group>
                            <field name="price" />
                            <field name="total_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="add_bill_action" model="ir.actions.act_window">
        <field name="name">Add Bill</field>
        <field name="res_model">add.bill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>