<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_payment_line_tree_view" model="ir.ui.view">
        <field name="name">appointment_payment_line.tree</field>
        <field name="model">appointment.payment.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="appointment_payment_line_ids" />
                <field name="appointment_booking_id" />
                <field name="patient_name" />
                <field name="patient_status" />
                <field name="date" />
                <field name="amount" />
            </list>
        </field>
    </record>
    <record id="appointment_payment_line_form_view" model="ir.ui.view">
        <field name="name">appointment_payment_line.form</field>
        <field name="model">appointment.payment.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="appointment_payment_line_ids" />
                            <field name="patient_name" />
                            <field name="date" />
                        </group>
                        <group>
                            <field name="appointment_booking_id" />
                            <field name="patient_status" />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="appointment_payment_line_action" model="ir.actions.act_window">
        <field name="name">appointment_payment_line</field>
        <field name="res_model">appointment.payment.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>