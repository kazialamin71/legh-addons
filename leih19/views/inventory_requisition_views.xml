<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="inventory_requisition_tree_view" model="ir.ui.view">
        <field name="name">inventory_requisition.tree</field>
        <field name="model">inventory.requisition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="reference_no" />
                <field name="warehouse_id" />
                <field name="partner_id" />
                <field name="challan_id" />
                <field name="expense_journal_id" />
                <field name="department" />
                <field name="date" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="inventory_requisition_form_view" model="ir.ui.view">
        <field name="name">inventory_requisition.form</field>
        <field name="model">inventory.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="warehouse_id" />
                            <field name="challan_id" />
                            <field name="department" />
                        </group>
                        <group>
                            <field name="reference_no" />
                            <field name="partner_id" />
                            <field name="expense_journal_id" />
                            <field name="date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Inventory Requisition Line">
                            <field name="inventory_requisition_line_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="inventory_requisition_action" model="ir.actions.act_window">
        <field name="name">inventory_requisition</field>
        <field name="res_model">inventory.requisition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>