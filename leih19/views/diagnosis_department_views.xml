<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="diagnosis_department_tree_view" model="ir.ui.view">
        <field name="name">diagnosis_department.tree</field>
        <field name="model">diagnosis.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="parent" />
            </list>
        </field>
    </record>
    <record id="diagnosis_department_form_view" model="ir.ui.view">
        <field name="name">diagnosis_department.form</field>
        <field name="model">diagnosis.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="parent" />
                            <field name="signatory_id" />
                            <field name="modality" />
                        </group>
                    </group>
                    <group string="Report Disclaimer">
                        <field name="report_disclaimer_html" widget="html" nolabel="1"
                               placeholder="Leave empty to use the company-wide disclaimer."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="diagnosis_department_action" model="ir.actions.act_window">
        <field name="name">Diagnosis Department</field>
        <field name="res_model">diagnosis.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>