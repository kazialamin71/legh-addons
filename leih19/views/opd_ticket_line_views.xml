<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="opd_ticket_line_tree_view" model="ir.ui.view">
        <field name="name">opd_ticket_line.tree</field>
        <field name="model">opd.ticket.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="opd_ticket_id" />
                <field name="price" />
                <field name="department" />
                <field name="total_amount" />
            </list>
        </field>
    </record>
    <record id="opd_ticket_line_form_view" model="ir.ui.view">
        <field name="name">opd_ticket_line.form</field>
        <field name="model">opd.ticket.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="price" />
                            <field name="total_amount" />
                        </group>
                        <group>
                            <field name="opd_ticket_id" />
                            <field name="department" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="opd_ticket_line_action" model="ir.actions.act_window">
        <field name="name">opd_ticket_line</field>
        <field name="res_model">opd.ticket.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>