<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="discount_category_tree_view" model="ir.ui.view">
        <field name="name">discount_category.tree</field>
        <field name="model">discount.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="parent" />
                <field name="account_id" />
            </list>
        </field>
    </record>
    <record id="discount_category_form_view" model="ir.ui.view">
        <field name="name">discount_category.form</field>
        <field name="model">discount.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="account_id" />
                        </group>
                        <group>
                            <field name="parent" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="discount_category_action" model="ir.actions.act_window">
        <field name="name">discount_category</field>
        <field name="res_model">discount.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>