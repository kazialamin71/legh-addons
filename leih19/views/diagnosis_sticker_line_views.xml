<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="diagnosis_sticker_line_tree_view" model="ir.ui.view">
        <field name="name">diagnosis_sticker_line.tree</field>
        <field name="model">diagnosis.sticker.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="test_name" />
                <field name="sticker_id" />
                <field name="result" />
                <field name="ref_value" />
                <field name="bold" />
                <field name="group_by" />
                <field name="remarks" />
            </list>
        </field>
    </record>
    <record id="diagnosis_sticker_line_form_view" model="ir.ui.view">
        <field name="name">diagnosis_sticker_line.form</field>
        <field name="model">diagnosis.sticker.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="test_name" />
                            <field name="result" />
                            <field name="bold" />
                            <field name="remarks" />
                        </group>
                        <group>
                            <field name="sticker_id" />
                            <field name="ref_value" />
                            <field name="group_by" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="diagnosis_sticker_line_action" model="ir.actions.act_window">
        <field name="name">diagnosis_sticker_line</field>
        <field name="res_model">diagnosis.sticker.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>