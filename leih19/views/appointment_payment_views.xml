<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_payment_tree_view" model="ir.ui.view">
        <field name="name">appointment_payment.tree</field>
        <field name="model">appointment.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="cal_st_date" />
                <field name="cal_end_date" />
                <field name="ref_doctors" />
                <field name="total_payable_amount" />
            </list>
        </field>
    </record>
    <record id="appointment_payment_form_view" model="ir.ui.view">
        <field name="name">appointment_payment.form</field>
        <field name="model">appointment.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="cal_st_date" />
                            <field name="ref_doctors" />
                        </group>
                        <group>
                            <field name="cal_end_date" />
                            <field name="total_payable_amount" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointment Payment Line">
                            <field name="appointment_payment_line_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="appointment_payment_action" model="ir.actions.act_window">
        <field name="name">appointment_payment</field>
        <field name="res_model">appointment.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>