<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="lab_print_confirm_form" model="ir.ui.view">
        <field name="name">lab.print.confirm.form</field>
        <field name="model">lab.print.confirm</field>
        <field name="arch" type="xml">
            <form string="Print Lab Report">
                <group>
                    <field name="bill_register_id" invisible="1"/>
                    <field name="message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print Verified Only"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
