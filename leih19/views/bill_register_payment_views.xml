<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="bill_register_payment_tree_view" model="ir.ui.view">
        <field name="name">bill_register_payment.tree</field>
        <field name="model">bill.register.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="bill_id" />
                <field name="date" />
                <field name="amount" />
                <field name="payment_type" />
                <field name="service_charge" />
                <field name="to_be_paid" />
                <field name="account_number" />
                <field name="money_receipt_id" />
            </list>
        </field>
    </record>
    <record id="bill_register_payment_form_view" model="ir.ui.view">
        <field name="name">bill_register_payment.form</field>
        <field name="model">bill.register.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="bill_id" />
                        <field name="date" />
                        <field name="amount" />
                        <field name="payment_type" />
                        <field name="service_charge" />
                        <field name="to_be_paid" />
                        <field name="account_number" />
                        <field name="money_receipt_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="bill_register_payment_action" model="ir.actions.act_window">
        <field name="name">bill_register_payment</field>
        <field name="res_model">bill.register.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>