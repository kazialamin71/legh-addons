<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="doctors_profile_tree_view" model="ir.ui.view">
        <field name="name">doctors_profile.tree</field>
        <field name="model">doctors.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="doctor_id" />
                <field name="department" />
                <field name="designation" />
                <field name="degree" />
                <field name="type" />
                <field name="status" />
                <field name="others" />
                <field name="admission_info" />
                <field name="ipd_visit" />
                <field name="commission_rate" />
                <field name="last_commission_calculation_date" />
                <field name="referral_id" />
                <field name="is_referral" />
            </list>
        </field>
    </record>
    <record id="doctors_profile_form_view" model="ir.ui.view">
        <field name="name">doctors_profile.form</field>
        <field name="model">doctors.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="department" />
                            <field name="degree" />
                            <field name="others" />
                            <field name="commission_rate" />
                            <field name="referral_id" />
                            <field name="is_referral" />
                        </group>
                        <group>
                            <field name="doctor_id" />
                            <field name="user_id"
                                   options="{'no_quick_create': True, 'no_create_edit': True}" />
                            <field name="designation" />
                            <field name="type" />
                            <field name="admission_info" />
                            <field name="ipd_visit" />
                            <field name="last_commission_calculation_date" />
                            <field name="broker_ids" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Bill Info">
                            <field name="bill_info" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="doctors_profile_action" model="ir.actions.act_window">
        <field name="name">doctors_profile</field>
        <field name="res_model">doctors.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>