<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="opd_ticket_tree_view" model="ir.ui.view">
        <field name="name">opd_ticket.tree</field>
        <field name="model">opd.ticket</field>
        <field name="arch" type="xml">
            <list string="OPD Tickets">
                <field name="date" />
                <field name="name" />
                <field name="patient_id" />
                <field name="patient_name" />
                <field name="mobile" />
                <field name="age" optional="show" />
                <field name="sex" optional="hide" />
                <field name="address" optional="hide" />
                <field name="ref_doctors" />
                <field name="user_id" optional="hide" />
                <field name="prescription_count" optional="hide" />
                <field name="already_collected" optional="show" />
                <field name="total" sum="Total" />
                <field name="with_doctor_total" sum="Total with Doctor Fee" optional="hide" />
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'" />
            </list>
        </field>
    </record>
    <record id="opd_ticket_form_view" model="ir.ui.view">
        <field name="name">opd_ticket.form</field>
        <field name="model">opd.ticket</field>
        <field name="arch" type="xml">
            <form string="OPD Ticket">
                <header>
                    <button name="action_create_prescription" type="object" string="Create Prescription" class="btn-primary" />
                    <button name="action_view_prescriptions" type="object" string="Prescriptions" class="btn-secondary"
                            invisible="prescription_count == 0" />
                    <field name="state" widget="statusbar" statusbar_visible="confirmed" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prescriptions" type="object"
                                class="oe_stat_button" icon="fa-stethoscope"
                                invisible="prescription_count == 0">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Ticket" />
                        <h1><field name="name" class="oe_inline" placeholder="Ticket reference" /></h1>
                    </div>
                    <group>
                        <group string="Patient" name="patient_info">
                            <field name="patient_name"
                                   context="{'patient_display_contact': 1}"
                                   options="{'no_quick_create': True}"
                                   placeholder="Search by name, mobile or patient id..." />
                            <field name="patient_id" readonly="1" />
                            <field name="mobile" readonly="1" />
                            <field name="age" readonly="1" />
                            <field name="sex" readonly="1" />
                            <field name="address" readonly="1" />
                        </group>
                        <group string="Ticket Details" name="ticket_info">
                            <field name="date" />
                            <field name="ref_doctors"
                                   options="{'no_quick_create': True, 'no_create_edit': True}" />
                            <field name="user_id" />
                            <field name="already_collected" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Ticket Items" name="ticket_items">
                            <field name="opd_ticket_line_id">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="department" />
                                    <field name="price" />
                                    <field name="total_amount" sum="Total" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group name="opd_bottom" col="6" class="mt-3">
                        <group colspan="4" name="opd_bottom_left" />
                        <group class="oe_subtotal_footer" colspan="2" name="opd_totals">
                            <field name="total" class="oe_subtotal_footer_separator" />
                            <field name="with_doctor_total" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="opd_ticket_search_view" model="ir.ui.view">
        <field name="name">opd_ticket.search</field>
        <field name="model">opd.ticket</field>
        <field name="arch" type="xml">
            <search string="OPD Tickets">
                <!-- One box that matches a patient by name, mobile number or patient id. -->
                <field name="patient_name" string="Patient / Mobile"
                       filter_domain="['|', '|', ('patient_name', 'ilike', self), ('patient_name.mobile', 'ilike', self), ('patient_name.patient_id', 'ilike', self)]" />
                <field name="patient_id" string="Patient Id" />
                <field name="name" string="Ticket" />
                <field name="ref_doctors" />
                <separator />
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]" />
                <separator />
                <filter string="Money Collected" name="collected" domain="[('already_collected', '=', True)]" />
                <filter string="Not Collected" name="not_collected" domain="[('already_collected', '=', False)]" />
                <separator />
                <filter string="Today" name="today" domain="[('date', '=', 'today')]" />
                <separator />
                <filter string="Group by Doctor" name="group_doctor" context="{'group_by': 'ref_doctors'}" />
                <filter string="Group by Status" name="group_state" context="{'group_by': 'state'}" />
                <filter string="Group by Date" name="group_date" context="{'group_by': 'date'}" />
            </search>
        </field>
    </record>
    <record id="opd_ticket_action" model="ir.actions.act_window">
        <field name="name">OPD Ticket</field>
        <field name="res_model">opd.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="opd_ticket_search_view" />
    </record>
</odoo>
