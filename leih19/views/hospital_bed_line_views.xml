<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hospital_bed_line_tree_view" model="ir.ui.view">
        <field name="name">hospital_bed_line.tree</field>
        <field name="model">hospital.bed.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="hospital_bed_item_id" />
                <field name="bed_no" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="bed_qty" />
                <field name="perday_charge" />
                <field name="total_amount" />
            </list>
        </field>
    </record>
    <record id="hospital_bed_line_form_view" model="ir.ui.view">
        <field name="name">hospital_bed_line.form</field>
        <field name="model">hospital.bed.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="hospital_bed_item_id" />
                            <field name="end_date" />
                            <field name="perday_charge" />
                        </group>
                        <group>
                            <field name="bed_no" />
                            <field name="start_date" />
                            <field name="bed_qty" />
                            <field name="total_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_bed_line_action" model="ir.actions.act_window">
        <field name="name">hospital_bed_line</field>
        <field name="res_model">hospital.bed.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>