<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="patient_info_tree_view" model="ir.ui.view">
        <field name="name">patient_info.tree</field>
        <field name="model">patient.info</field>
        <field name="arch" type="xml">
            <list>
                <field name="mobile" />
                <field name="patient_id" />
                <field name="name" />
                <field name="age" />
                <field name="address" />
                <field name="sex" />
                <field name="photo" />
                <field name="testname" />
                <field name="state" />
                <field name="bill_count" />
            </list>
        </field>
    </record>
    <record id="patient_info_form_view" model="ir.ui.view">
        <field name="name">patient_info.form</field>
        <field name="model">patient.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_report_patient_id_card)d" type="action" string="Print ID Card" class="btn-primary" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bills" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Bills" />
                        </button>
                    </div>
                    <group string="Information">
                        <group>
                            <field name="mobile" />
                            <field name="name" />
                            <field name="address" />
                            <field name="photo" widget="image_webcam" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="patient_id" />
                            <field name="age" />
                            <field name="sex" />
                            <field name="testname" />
                            <field name="bill_count" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Bills">
                            <field name="bills" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="patient_info_search_view" model="ir.ui.view">
        <field name="name">patient_info.search</field>
        <field name="model">patient.info</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name" string="Patient"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('mobile', 'ilike', self), ('patient_id', 'ilike', self)]" />
                <field name="mobile" string="Mobile / Phone" />
                <field name="patient_id" />
                <field name="address" />
                <separator />
                <filter string="Male" name="male" domain="[('sex', '=', 'male')]" />
                <filter string="Female" name="female" domain="[('sex', '=', 'female')]" />
                <separator />
                <filter string="Group by Sex" name="group_sex" context="{'group_by': 'sex'}" />
            </search>
        </field>
    </record>
    <record id="patient_info_action" model="ir.actions.act_window">
        <field name="name">Patient Information</field>
        <field name="res_model">patient.info</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="patient_info_search_view" />
    </record>
</odoo>