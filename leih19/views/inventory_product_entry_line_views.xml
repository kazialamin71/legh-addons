<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="inventory_product_entry_line_tree_view" model="ir.ui.view">
        <field name="name">inventory_product_entry_line.tree</field>
        <field name="model">inventory.product.entry.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="inventory_product_entry_id" />
                <field name="product_name" />
                <field name="account_id" />
                <field name="quantity" />
                <field name="unit_price" />
                <field name="total_price" />
            </list>
        </field>
    </record>
    <record id="inventory_product_entry_line_form_view" model="ir.ui.view">
        <field name="name">inventory_product_entry_line.form</field>
        <field name="model">inventory.product.entry.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="product_name" />
                            <field name="quantity" />
                            <field name="total_price" />
                        </group>
                        <group>
                            <field name="inventory_product_entry_id" />
                            <field name="account_id" />
                            <field name="unit_price" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="inventory_product_entry_line_action" model="ir.actions.act_window">
        <field name="name">inventory_product_entry_line</field>
        <field name="res_model">inventory.product.entry.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>