<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="ambulance_expense_tree_view" model="ir.ui.view">
        <field name="name">ambulance_expense.tree</field>
        <field name="model">ambulance.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="ambulance_id" />
                <field name="fuel_cost" />
                <field name="other_cost" />
                <field name="description" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="ambulance_expense_form_view" model="ir.ui.view">
        <field name="name">ambulance_expense.form</field>
        <field name="model">ambulance.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="ambulance_id" />
                            <field name="other_cost" />
                        </group>
                        <group>
                            <field name="fuel_cost" />
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ambulance_expense_action" model="ir.actions.act_window">
        <field name="name">ambulance_expense</field>
        <field name="res_model">ambulance.expense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>