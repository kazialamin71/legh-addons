<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="laundry_clean_tree_view" model="ir.ui.view">
        <field name="name">laundry_clean.tree</field>
        <field name="model">laundry.clean</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="send_date" />
                <field name="laundry_name" />
                <field name="back_date" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="laundry_clean_form_view" model="ir.ui.view">
        <field name="name">laundry_clean.form</field>
        <field name="model">laundry.clean</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="laundry_name" />
                        </group>
                        <group>
                            <field name="send_date" />
                            <field name="back_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Line">
                            <field name="product_line" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="laundry_clean_action" model="ir.actions.act_window">
        <field name="name">laundry_clean</field>
        <field name="res_model">laundry.clean</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>