<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="ambulance_booking_tree_view" model="ir.ui.view">
        <field name="name">ambulance_booking.tree</field>
        <field name="model">ambulance.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="booking_type" />
                <field name="name" />
                <field name="patient_id" />
                <field name="mobile_no" />
                <field name="start_from" />
                <field name="destination" />
                <field name="amount" />
                <field name="advance_amount" />
                <field name="paid_amount" />
                <field name="unpaid_amount" />
                <field name="grace_time" />
                <field name="date" />
                <field name="ambulance_id" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="ambulance_booking_form_view" model="ir.ui.view">
        <field name="name">ambulance_booking.form</field>
        <field name="model">ambulance.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="booking_type" />
                            <field name="patient_id" />
                            <field name="start_from" />
                            <field name="amount" />
                            <field name="paid_amount" />
                            <field name="grace_time" />
                            <field name="ambulance_id" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="mobile_no" />
                            <field name="destination" />
                            <field name="advance_amount" />
                            <field name="unpaid_amount" />
                            <field name="date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ambulance_booking_action" model="ir.actions.act_window">
        <field name="name">ambulance_booking</field>
        <field name="res_model">ambulance.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>