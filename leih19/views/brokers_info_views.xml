<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="brokers_info_tree_view" model="ir.ui.view">
        <field name="name">brokers_info.tree</field>
        <field name="model">brokers.info</field>
        <field name="arch" type="xml">
            <list>
                <field name="broker_id" />
                <field name="broker_name" />
                <field name="status" />
                <field name="commission_rate" />
                <field name="last_commission_calculation_date" />
            </list>
        </field>
    </record>
    <record id="brokers_info_form_view" model="ir.ui.view">
        <field name="name">brokers_info.form</field>
        <field name="model">brokers.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="broker_id" />
                            <field name="commission_rate" />
                            <field name="doctor_ids" />
                        </group>
                        <group>
                            <field name="broker_name" />
                            <field name="last_commission_calculation_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Bill Info">
                            <field name="bill_info" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="brokers_info_action" model="ir.actions.act_window">
        <field name="name">brokers_info</field>
        <field name="res_model">brokers.info</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>