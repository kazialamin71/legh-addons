<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="payment_type_tree_view" model="ir.ui.view">
        <field name="name">payment_type.tree</field>
        <field name="model">payment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="account" />
                <field name="service_charge_account" />
                <field name="service_charge" />
                <field name="service_charge_flat" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="payment_type_form_view" model="ir.ui.view">
        <field name="name">payment_type.form</field>
        <field name="model">payment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="service_charge_account" />
                            <field name="service_charge_flat" />
                        </group>
                        <group>
                            <field name="account" />
                            <field name="service_charge" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="payment_type_action" model="ir.actions.act_window">
        <field name="name">payment_type</field>
        <field name="res_model">payment.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>