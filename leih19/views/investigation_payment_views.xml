<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="investigation_payment_tree_view" model="ir.ui.view">
        <field name="name">investigation_payment.tree</field>
        <field name="model">investigation.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="cal_st_date" />
                <field name="cal_end_date" />
                <field name="ref_doctors" />
                <field name="given_discount_amount" />
                <field name="total_amount" />
                <field name="total_bill" />
                <field name="total_tests" />
                <field name="paid_amount" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="investigation_payment_form_view" model="ir.ui.view">
        <field name="name">investigation_payment.form</field>
        <field name="model">investigation.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="cal_st_date" />
                            <field name="ref_doctors" />
                            <field name="total_amount" />
                            <field name="total_tests" />
                        </group>
                        <group>
                            <field name="cal_end_date" />
                            <field name="given_discount_amount" />
                            <field name="total_bill" />
                            <field name="paid_amount" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Investigation Payment Line">
                            <field name="investigation_payment_line_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="investigation_payment_action" model="ir.actions.act_window">
        <field name="name">investigation_payment</field>
        <field name="res_model">investigation.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>