<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_bill_register_list" model="ir.ui.view">
        <field name="name">bill.register.list</field>
        <field name="model">bill.register</field>
        <field name="arch" type="xml">
            <list string="Bill Register">
                <field name="name" />
                <field name="mobile" />
                <field name="patient_name" />
                <field name="patient_id" />
                <field name="address" />
                <field name="age" />
                <field name="sex" />
                <field name="diagonostic_bill" />
                <field name="ref_doctors" />
                <field name="referral" />
                <field name="doctors_discounts" />
                <field name="other_discount" />
                <field name="after_discount" />
                <field name="total_without_discount" />
                <field name="total" />
                <field name="grand_total" />
                <field name="paid" />
                <field name="due" />

                <field name="card_no" />
                <field name="bank_name" />
                <field name="payment_type" />
                <field name="service_charge" />
                <field name="to_be_paid" />
                <field name="account_number" />
                <field name="discount_remarks" />
                <field name="date" />
                <field name="user_id" />
                <field name="state" />
                <field name="old_journal" />
                <field name="general_admission_id" />
                <field name="is_applied_to_admission" />
            </list>
        </field>
    </record>
    <record id="view_bill_register_form" model="ir.ui.view">
        <field name="name">bill.register.form</field>
        <field name="model">bill.register</field>
        <field name="arch" type="xml">
            <form string="Bill Register">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="patient_name" />
                            <field name="address" />
                            <field name="sex" />
                            <field name="ref_doctors" />
                            <field name="doctors_discounts" />
                            <field name="after_discount" readonly="1" />
                            <field name="total" readonly="1" />
                            <field name="paid" />
                            <field name="bank_name" />
                            <field name="service_charge" readonly="1" />
                            <field name="account_number" />
                            <field name="date" readonly="1" />
                            <field name="old_journal" />
                            <field name="is_applied_to_admission" />
                        </group>
                        <group>
                            <field name="mobile" />
                            <field name="patient_id" readonly="1" />
                            <field name="age" />
                            <field name="diagonostic_bill" />
                            <field name="referral" />
                            <field name="other_discount" />
                            <field name="total_without_discount" readonly="1" />
                            <field name="grand_total" readonly="1" />
                            <field name="due" readonly="1" />
                            <field name="card_no" />
                            <field name="payment_type" />
                            <field name="to_be_paid" readonly="1" />
                            <field name="discount_remarks" />
                            <field name="user_id" />
                            <field name="general_admission_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Bill Register Line">
                            <field name="bill_register_line_id">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="department" readonly="1" />
                                    <field name="product_qty" />
                                    <field name="delivery_date" readonly="1" />
                                    <field name="price" readonly="1" />
                                    <field name="discount" />
                                    <field name="flat_discount" />
                                    <field name="total_discount" readonly="1" />
                                    <field name="total_amount" readonly="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Bill Register Payment Line">
                            <field name="bill_register_payment_line_id" readonly="1">
                                <list>
                                    <field name="date" />
                                    <field name="amount" />
                                    <field name="payment_type" />
                                    <field name="money_receipt_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Bill Journal Relation">
                            <field name="bill_journal_relation_id" readonly="1">
                                <list>
                                    <field name="journal_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bill_register_search" model="ir.ui.view">
        <field name="name">bill.register.search</field>
        <field name="model">bill.register</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="patient_name" />
                <field name="ref_doctors" />

                <field name="state" />
                <filter string="Pending" name="pending" domain="[('state','=','pending')]" />
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]" />
                <group>
                    <filter string="Patient" name="group_patient" context="{'group_by':'patient_name'}" />
                    <filter string="Doctor" name="group_doctor" context="{'group_by':'ref_doctors'}" />
                    <filter string="Status" name="group_state" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_bill_register" model="ir.actions.act_window">
        <field name="name">Bill Register</field>
        <field name="res_model">bill.register</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bill_register_list" />
        <field name="search_view_id" ref="view_bill_register_search" />
        <field name="context">{}</field>

    </record>
    <menuitem id="menu_leis_root" name="LEIS" sequence="10" />
    <menuitem id="menu_bill_register" name="Bill Register" parent="menu_leis_root" action="action_bill_register" sequence="20" />
</odoo>