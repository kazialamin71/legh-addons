<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="admission_payment_configuration_line_tree_view" model="ir.ui.view">
        <field name="name">admission.payment.configuration.line.list</field>
        <field name="model">admission.payment.configuration.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="admission_configuration_line_ids" />
                <field name="department_id" />
                <field name="test_id" />
                <field name="applicable" />
                <field name="fixed_amount" />
                <field name="variance_amount" />
                <field name="test_price" />
                <field name="est_admission_amount" />
                <field name="max_admission_amount" />
            </list>
        </field>
    </record>
    <record id="admission_payment_configuration_line_form_view" model="ir.ui.view">
        <field name="name">admission.payment.configuration.line.form</field>
        <field name="model">admission.payment.configuration.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="department_id" />
                            <field name="applicable" />
                            <field name="variance_amount" />
                            <field name="est_admission_amount" />
                        </group>
                        <group>
                            <field name="admission_configuration_line_ids" />
                            <field name="test_id" />
                            <field name="fixed_amount" />
                            <field name="test_price" />
                            <field name="max_admission_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="admission_payment_configuration_line_action" model="ir.actions.act_window">
        <field name="name">Admission Payment Configuration Line</field>
        <field name="res_model">admission.payment.configuration.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>