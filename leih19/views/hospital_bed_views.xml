<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hospital_bed_tree_view" model="ir.ui.view">
        <field name="name">hospital_bed.tree</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="bed_type" />
                <field name="bed_qty" />
                <field name="perday_charge" />
                <field name="total_amount" />
            </list>
        </field>
    </record>
    <record id="hospital_bed_form_view" model="ir.ui.view">
        <field name="name">hospital_bed.form</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="bed_type" />
                            <field name="perday_charge" />
                        </group>
                        <group>
                            <field name="bed_qty" />
                            <field name="total_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_bed_action" model="ir.actions.act_window">
        <field name="name">hospital_bed</field>
        <field name="res_model">hospital.bed</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>