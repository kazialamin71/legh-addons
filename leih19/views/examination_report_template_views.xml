<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="examination_report_template_tree_view" model="ir.ui.view">
        <field name="name">examination_report_template.tree</field>
        <field name="model">examination.report.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="report_type"/>
                <field name="department"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="examination_report_template_form_view" model="ir.ui.view">
        <field name="name">examination_report_template.form</field>
        <field name="model">examination.report.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="report_type"/>
                            <field name="department"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body_html" widget="html"/>
                        </page>
                        <page string="Applies To">
                            <field name="examination_entry_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="examination_report_template_action" model="ir.actions.act_window">
        <field name="name">Report Templates</field>
        <field name="res_model">examination.report.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
