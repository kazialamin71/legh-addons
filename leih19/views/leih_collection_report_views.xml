<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Summary: who collected how much, at which counter. -->
    <record id="leih_collection_report_pivot_view" model="ir.ui.view">
        <field name="name">leih.collection.report.pivot</field>
        <field name="model">leih.collection.report</field>
        <field name="arch" type="xml">
            <pivot string="Cash Collection" sample="1">
                <field name="user_id" type="row"/>
                <field name="section" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Details: every single transaction behind the summary. -->
    <record id="leih_collection_report_list_view" model="ir.ui.view">
        <field name="name">leih.collection.report.list</field>
        <field name="model">leih.collection.report</field>
        <field name="arch" type="xml">
            <list string="Collection Details" create="false" delete="false" edit="false">
                <field name="collected_on"/>
                <field name="user_id"/>
                <field name="section" widget="badge"/>
                <field name="reference"/>
                <field name="patient_name" optional="show"/>
                <field name="payment_method" optional="show"/>
                <field name="source_model" optional="hide"/>
                <field name="amount" sum="Total Collected"/>
                <button name="action_open_source" type="object" string="Open"
                        icon="fa-external-link" title="Open the source document"/>
            </list>
        </field>
    </record>

    <record id="leih_collection_report_graph_view" model="ir.ui.view">
        <field name="name">leih.collection.report.graph</field>
        <field name="model">leih.collection.report</field>
        <field name="arch" type="xml">
            <graph string="Cash Collection" type="bar" sample="1">
                <field name="user_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="leih_collection_report_search_view" model="ir.ui.view">
        <field name="name">leih.collection.report.search</field>
        <field name="model">leih.collection.report</field>
        <field name="arch" type="xml">
            <search string="Cash Collection">
                <field name="user_id" string="User / Counter"/>
                <field name="reference"/>
                <field name="patient_name"/>
                <!-- Custom range with a timestamp: pick "Collected On" and use
                     "is between" to enter both date and time. -->
                <field name="collected_on" string="Collected On"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="My Collection" name="my_collection"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Bill / Diagnostic" name="s_bill" domain="[('section', '=', 'bill')]"/>
                <filter string="Admission" name="s_admission" domain="[('section', '=', 'admission')]"/>
                <filter string="OPD" name="s_opd" domain="[('section', '=', 'opd')]"/>
                <filter string="Pharmacy" name="s_pharmacy" domain="[('section', '=', 'pharmacy')]"/>
                <separator/>
                <filter string="Collected On" name="group_by_date" date="collected_on"/>
                <filter string="Group by User" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Group by Section" name="group_section" context="{'group_by': 'section'}"/>
                <filter string="Group by Payment Method" name="group_method" context="{'group_by': 'payment_method'}"/>
            </search>
        </field>
    </record>

    <record id="leih_collection_report_action" model="ir.actions.act_window">
        <field name="name">User wise Cash Collection</field>
        <field name="res_model">leih.collection.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="leih_collection_report_search_view"/>
        <field name="context">{'search_default_group_user': 1, 'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No money collected in this period</p>
            <p>Every collection point feeds this report: bill / diagnostic and admission
               money receipts, OPD tickets marked collected, and pharmacy (POS) payments.</p>
        </field>
    </record>

    <!-- Details as its own menu entry: same data, opened straight on the list. -->
    <record id="leih_collection_detail_action" model="ir.actions.act_window">
        <field name="name">Cash Collection Details</field>
        <field name="res_model">leih.collection.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="leih_collection_report_search_view"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
