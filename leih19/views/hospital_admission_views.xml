<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hospital_admission_tree_view" model="ir.ui.view">
        <field name="name">hospital.admission.list</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <list string="Hospital Admission">
                <field name="name" />
                <field name="mobile" />
                <field name="patient_id" />
                <field name="patient_name" />
                <field name="address" />
                <field name="age" />
                <field name="sex" />
                <field name="ref_doctors" />
                <field name="operation_date" />
                <field name="release_note_date" />
                <field name="release_note" />
                <field name="package_name" />
                <field name="emergency" />
                <field name="total_without_discount" />
                <field name="total" />
                <field name="doctors_discounts" />
                <field name="after_discount" />
                <field name="other_discount" />
                <field name="discount_remarks" />
                <field name="grand_total" />
                <field name="investigation_total" />
                <field name="investigation_paid" />
                <field name="advance" />
                <field name="paid" />
                <field name="due" />
                <field name="payment_type" />
                <field name="card_no" />
                <field name="bank_name" />
                <field name="date" />
                <field name="user_id" />
                <field name="state" />
                <field name="emergency_covert_time" />
                <field name="old_journal" />
                <field name="payment_type" />
                <field name="service_charge" />
                <field name="to_be_paid" optional="hide"/>
                <field name="account_number" />
                <field name="father_name" />
                <field name="mother_name" />
                <field name="spouse_name" />
                <field name="religion" />
                <field name="blood_group" />
                <field name="referral" />
                <field name="occupation" />
                <field name="business_address" />
                <field name="admitting_doctor" />
                <field name="bed" />
                <field name="prescription_count" readonly="1" />
                <field name="received_by" />
                <field name="clinic_diagnosis" />
            </list>
        </field>
    </record>
    <record id="hospital_admission_form_view" model="ir.ui.view">
        <field name="name">hospital.admission.form</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <form string="Hospital Admission">
                <header>
                    <button string="Confirm and Print" type="object" name="hospital_change_status" groups="base.group_user" />
                    <button string="Final Settlement" type="object" name="btn_final_settlement" groups="base.group_user" />
                    <button string="Payment" type="object" name="btn_pay" groups="base.group_user" />
                    <button string="Calculate" type="object" name="calculate_bill" groups="base.group_user" />
                    <button string="Bill Investigation" type="object" name="btn_bill" groups="base.group_user" />
                    <!-- Unbound for now: it pointed at leih.group_admission_button_cancel,
                         which is defined in no addon, so Odoo warned on every view load
                         and the button was unreachable. Access control to be added. -->
                    <button string="Cancel" type="object" name="admission_cancel" />
                    <button string="Create Prescription" type="object" name="action_create_prescription" class="btn-primary" />
                    <button string="Prescriptions" type="object" name="action_view_prescriptions" class="btn-secondary" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Admission No"/>
                        <h1><field name="name" readonly="1" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group string="Patient" name="patient_info">
                            <field name="patient_name"
                                   context="{'patient_display_contact': 1}"
                                   options="{'no_quick_create': True}"
                                   placeholder="Search by name, mobile or patient id..."/>
                            <field name="patient_id" readonly="1"/>
                            <field name="mobile" readonly="1"/>
                            <field name="age" readonly="1"/>
                            <field name="sex" readonly="1"/>
                            <field name="blood_group"/>
                            <field name="address" readonly="1"/>
                            <field name="release_note_date"/>
                            <field name="release_note" placeholder="Release / discharge note..."/>
                        </group>
                        <group string="Admission Details" name="admission_info">
                            <field name="date" readonly="1"/>
                            <field name="admitting_doctor"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="ref_doctors" placeholder="Select Doctor Name"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="referral" placeholder="Broker who referred the patient"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="bed"/>
                            <field name="package_name"/>
                            <field name="clinic_diagnosis"/>
                            <field name="operation_date"/>
                            <field name="emergency"/>
                            <field name="emergency_covert_time" invisible="not emergency"/>
                            <field name="user_id"/>
                            <field name="received_by"/>
                            <field name="prescription_count" readonly="1"/>
                        </group>
                    </group>
                    <!-- Order follows the ward workflow: charges (added by
                         leih_admission) - services - bed - medicine - visits.
                         The form still opens on the admission lines: that page
                         carries autofocus, so the Charges page inserted ahead of
                         it does not steal the default tab. -->
                    <notebook>
                        <page string="Leih Admission Line" name="page_admission_line" autofocus="autofocus">
                            <field name="leih_admission_line_id">
                                <list editable="bottom">
                                    <field name="name"
                                           options="{'no_quick_create': True, 'no_create_edit': True}" />
                                    <field name="charge_type" optional="show" widget="badge" />
                                    <field name="department" />
                                    <field name="product_qty" />
                                    <field name="price" />
                                    <field name="discount" />
                                    <field name="discount_percent" />
                                    <field name="flat_discount" />
                                    <field name="total_discount" />
                                    <field name="total_amount" />
                                </list>
                            </field>
                        </page>
                        <page string="Investigation Entry" name="page_investigation">
                            <field name="investigation_bill_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="grand_total" sum="Total"/>
                                    <field name="paid" sum="Paid"/>
                                    <field name="due" sum="Due"/>
                                    <field name="is_applied_to_admission" string="On Admission Bill"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Hospital Bed Line" name="page_bed">
                            <field name="hospital_bed_line_id">
                                <list editable="bottom">
                                    <field name="bed_no" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                    <field name="bed_qty" />
                                    <field name="perday_charge" />
                                    <field name="total_amount" />
                                </list>
                            </field>
                        </page>
                        <page string="Medicine Line" name="page_medicine">
                            <!-- leih_pharmacy injects the requisition list before this field. -->
                            <separator string="Manual Medicine Charges" name="manual_medicine"/>
                            <field name="hospital_medicine_line_id">
                                <list editable="bottom">
                                    <field name="product_name" />
                                    <field name="product_qty" />
                                    <field name="unit_price" />
                                    <field name="total_price" />
                                </list>
                            </field>
                        </page>
                        <page string="Consultant Visit Charge" name="page_visits">
                            <field name="hospital_doctor_line_id">
                                <list editable="bottom">
                                    <field name="doctor_profile_id"
                                           options="{'no_quick_create': True, 'no_create_edit': True}" />
                                    <field name="visit_datetime" />
                                    <field name="visit_fee" />
                                    <field name="doctor_visit_qty" optional="hide" />
                                    <field name="total_amount" sum="Total" />
                                </list>
                            </field>
                        </page>
                        <page string="Patient Details" name="patient_details">
                            <group>
                                <group string="Guardian / Attendant" name="guardian">
                                    <field name="guardian_name"/>
                                    <field name="guardian_relation"/>
                                    <field name="guardian_occupation"/>
                                    <field name="guardian_contact"/>
                                </group>
                            </group>
                        </page>
                        <page string="Guarantor Line" name="page_guarantor">
                            <field name="guarantor_line_id">
                                <list editable="top">
                                    <field name="name" />
                                    <field name="address" />
                                    <field name="relationship" />
                                    <field name="contact" />
                                </list>
                            </field>
                        </page>
                        <page string="Bill Register Admission Line" name="page_bill_register_line">
                            <field name="bill_register_admission_line_id" />
                        </page>
                        <page string="Admission Payment Line" name="page_payment_line">
                            <field name="admission_payment_line_id" />
                        </page>
                        <page string="Admission Journal Relation" name="page_journal">
                            <field name="admission_journal_relation_id">
                                <list editable="top">
                                    <field name="journal_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Hospital Bill Line" name="page_bill_line">
                            <field name="hospital_bill_line_id">
                                <list editable="bottom">
                                    <field name="item_name" />
                                    <field name="department" />
                                    <field name="bill_created_date" />
                                    <field name="price" />
                                    <field name="discount" />
                                    <field name="discount_percent" />
                                    <field name="flat_discount" />
                                    <field name="total_discount" />
                                    <field name="total_amount" />
                                </list>
                            </field>
                        </page>
                        <page string="Money Receipt" name="page_money_receipt">
                            <field name="money_receipt_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="date" />
                                    <field name="amount" />
                                    <field name="p_type" />
                                    <field name="payment_type" />
                                    <field name="bill_total_amount" />
                                    <field name="due_amount" />
                                    <field name="state" />
                                    <field name="user_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group name="admission_bottom" col="6" class="mt-3">
                        <group colspan="4" name="discount_and_payment">
                            <group string="Discounts" name="discounts">
                                <label for="doctors_discounts"/>
                                <div class="o_row">
                                    <field name="doctors_discounts" class="oe_inline"/>
                                    <span class="oe_inline">%</span>
                                </div>
                                <field name="after_discount" readonly="1"/>
                                <field name="other_discount"/>
                                <field name="referral_discount"
                                       invisible="not referral and not ref_doctors"/>
                                <field name="discount_remarks" placeholder="Reason for the discount..."/>
                            </group>
                            <group string="Payment Details" name="payment_details">
                                <field name="payment_type"/>
                                <field name="payment_is_cash" invisible="1"/>
                                <field name="bank_name" invisible="payment_is_cash or not payment_type"/>
                                <field name="card_no" invisible="payment_is_cash or not payment_type"/>
                                <field name="account_number" invisible="payment_is_cash or not payment_type"/>
                            </group>
                        </group>
                        <group class="oe_subtotal_footer" colspan="2" name="admission_totals">
                            <field name="total_without_discount" readonly="1"/>
                            <field name="total" readonly="1"/>
                            <field name="investigation_total"/>
                            <field name="grand_total" readonly="1" class="oe_subtotal_footer_separator"/>
                            <field name="advance"/>
                            <field name="investigation_paid"/>
                            <field name="paid"/>
                            <field name="service_charge" invisible="service_charge == 0"/>
                            <field name="due" readonly="1" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_admission_graph_view" model="ir.ui.view">
        <field name="name">hospital.admission.graph</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <graph string="Admission Graph">
                <field name="patient_name" />
            </graph>
        </field>
    </record>
    <record id="hospital_admission_search_view" model="ir.ui.view">
        <field name="name">hospital.admission.search</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <search string="Hospital Admission">
                <!-- One box that matches a patient by name, mobile number or patient id. -->
                <field name="patient_name" string="Patient / Mobile"
                       filter_domain="['|', '|', ('patient_name', 'ilike', self), ('mobile', 'ilike', self), ('patient_id', 'ilike', self)]" />
                <field name="mobile" string="Mobile / Phone" />
                <field name="patient_id" string="Patient Id" />
                <field name="name" string="Admission No" />
                <field name="admitting_doctor" />
                <field name="ref_doctors" />
                <field name="bed" />
                <separator />
                <filter string="Pending" name="pending" domain="[('state','=','pending')]" />
                <filter string="Admitted" name="activated" domain="[('state','=','activated')]" />
                <filter string="Released" name="released" domain="[('state','=','released')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]" />
                <separator />
                <filter string="Emergency" name="emergency" domain="[('emergency','=',True)]" />
                <filter string="With Due" name="with_due" domain="[('due','&gt;',0)]" />
                <separator />
                <filter string="Group by Patient" name="group_patient" context="{'group_by':'patient_name'}" />
                <filter string="Group by Doctor" name="group_doctor" context="{'group_by':'admitting_doctor'}" />
                <filter string="Group by Status" name="group_state" context="{'group_by':'state'}" />
                <filter string="Group by Date" name="group_date" context="{'group_by':'date:day'}" />
            </search>
        </field>
    </record>
    <record id="hospital_admission_action" model="ir.actions.act_window">
        <field name="name">Admission Form</field>
        <field name="res_model">hospital.admission</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="hospital_admission_search_view" />
        <field name="domain">[('state','=','pending'),('emergency','=',False)]</field>
        <field name="context">{}</field>
    </record>
</odoo>