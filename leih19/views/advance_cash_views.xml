<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="advance_cash_tree_view" model="ir.ui.view">
        <field name="name">advance_cash.tree</field>
        <field name="model">advance.cash</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="name" />
                <field name="purpose" />
                <field name="amount" />
                <field name="journal_id" />
                <field name="credit_accounts" />
                <field name="debit_accounts" />
                <field name="partner_id" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="advance_cash_form_view" model="ir.ui.view">
        <field name="name">advance_cash.form</field>
        <field name="model">advance.cash</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="date" />
                            <field name="purpose" />
                            <field name="journal_id" />
                            <field name="debit_accounts" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="amount" />
                            <field name="credit_accounts" />
                            <field name="partner_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="advance_cash_action" model="ir.actions.act_window">
        <field name="name">advance_cash</field>
        <field name="res_model">advance.cash</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>