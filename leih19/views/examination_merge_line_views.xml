<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="examination_merge_line_tree_view" model="ir.ui.view">
        <field name="name">examination_merge_line.tree</field>
        <field name="model">examination.merge.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="examinationentry_id" />
            </list>
        </field>
    </record>
    <record id="examination_merge_line_form_view" model="ir.ui.view">
        <field name="name">examination_merge_line.form</field>
        <field name="model">examination.merge.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="merge_id" />
                        </group>
                        <group>
                            <field name="examinationentry_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="examination_merge_line_action" model="ir.actions.act_window">
        <field name="name">examination_merge_line</field>
        <field name="res_model">examination.merge.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>