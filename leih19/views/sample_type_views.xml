<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="sample_type_tree_view" model="ir.ui.view">
        <field name="name">sample_type.tree</field>
        <field name="model">sample.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="sample_type_form_view" model="ir.ui.view">
        <field name="name">sample_type.form</field>
        <field name="model">sample.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                        </group>
                        <group />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sample_type_action" model="ir.actions.act_window">
        <field name="name">sample_type</field>
        <field name="res_model">sample.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>