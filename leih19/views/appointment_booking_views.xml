<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_booking_tree_view" model="ir.ui.view">
        <field name="name">appointment_booking.tree</field>
        <field name="model">appointment.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="patient_name" />
                <field name="age" />
                <field name="sex" />
                <field name="phone" />
                <field name="address" />
                <field name="doctor_name" />
                <field name="time" widget="float_time_12h" />
                <field name="date" />
                <field name="status" />
                <field name="patient_status" />
                <field name="amount" />
                <field name="payment_done" />
            </list>
        </field>
    </record>
    <record id="appointment_booking_form_view" model="ir.ui.view">
        <field name="name">appointment_booking.form</field>
        <field name="model">appointment.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <!-- Single column, stacked groups, on purpose.
                         This form is filled in from a patient standing at the
                         counter, so the whole of it has to be reachable with Tab
                         alone. Side-by-side groups look tidier but Tab follows
                         the DOM, so it walks the left column to the bottom of
                         the sheet and then jumps back up to the top of the
                         right one, which is how the desk ended up reaching for
                         the mouse halfway through every booking. Keep each
                         group one column and keep the identity fields together
                         and in the order they are asked for. -->
                    <group name="group_appointment" string="Appointment">
                        <field name="name" />
                        <field name="doctor_name" />
                        <field name="date" />
                        <field name="time" widget="float_time_12h" />
                    </group>
                    <group name="group_patient" string="Patient Information">
                        <field name="patient_name" />
                        <field name="age" />
                        <field name="sex" />
                        <field name="phone" />
                        <field name="address" />
                        <field name="patient_status" />
                    </group>
                    <group name="group_fee" string="Consultation Fee">
                        <field name="amount" />
                        <field name="payment_done" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="appointment_booking_action" model="ir.actions.act_window">
        <field name="name">appointment_booking</field>
        <field name="res_model">appointment.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
