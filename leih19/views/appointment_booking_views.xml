<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_booking_tree_view" model="ir.ui.view">
        <field name="name">appointment_booking.tree</field>
        <field name="model">appointment.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="patient_name" />
                <field name="age" />
                <field name="sex" />
                <field name="phone" />
                <field name="address" />
                <field name="doctor_name" />
                <field name="time" widget="float_time" />
                <field name="date" />
                <field name="status" />
                <field name="patient_status" />
                <field name="amount" />
                <field name="payment_done" />
            </list>
        </field>
    </record>
    <record id="appointment_booking_form_view" model="ir.ui.view">
        <field name="name">appointment_booking.form</field>
        <field name="model">appointment.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="age" />
                            <field name="phone" />
                            <field name="doctor_name" />
                            <field name="date" />
                            <field name="amount" />
                        </group>
                        <group>
                            <field name="patient_name" />
                            <field name="sex" />
                            <field name="address" />
                            <field name="time" widget="float_time" />
                            <field name="patient_status" />
                            <field name="payment_done" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="appointment_booking_action" model="ir.actions.act_window">
        <field name="name">appointment_booking</field>
        <field name="res_model">appointment.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>