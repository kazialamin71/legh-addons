<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="doctor_profile_admission_line_tree_view" model="ir.ui.view">
        <field name="name">doctor_profile_admission_line.tree</field>
        <field name="model">doctor.profile.admission.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="doctor_profile_id" />
                <field name="hospital_doctor_line_item" />
                <field name="visit_datetime" />
                <field name="visit_fee" />
                <field name="doctor_visit_qty" optional="hide" />
                <field name="total_amount" sum="Total" />
            </list>
        </field>
    </record>
    <record id="doctor_profile_admission_line_form_view" model="ir.ui.view">
        <field name="name">doctor_profile_admission_line.form</field>
        <field name="model">doctor.profile.admission.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="doctor_profile_id" />
                            <field name="visit_datetime" />
                            <field name="visit_fee" />
                        </group>
                        <group>
                            <field name="hospital_doctor_line_item" />
                            <field name="doctor_visit_qty" />
                            <field name="total_amount" />
                            <field name="name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="doctor_profile_admission_line_action" model="ir.actions.act_window">
        <field name="name">doctor_profile_admission_line</field>
        <field name="res_model">doctor.profile.admission.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>