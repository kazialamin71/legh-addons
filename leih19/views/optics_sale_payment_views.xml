<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="optics_sale_payment_tree_view" model="ir.ui.view">
        <field name="name">optics_sale_payment.tree</field>
        <field name="model">optics.sale.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="optics_sale_id" />
                <field name="date" />
                <field name="amount" />
                <field name="payment_type" />
                <field name="service_charge" />
                <field name="to_be_paid" />
                <field name="account_number" />
                <field name="money_receipt_id" />
            </list>
        </field>
    </record>
    <record id="optics_sale_payment_form_view" model="ir.ui.view">
        <field name="name">optics_sale_payment.form</field>
        <field name="model">optics.sale.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="date" />
                            <field name="payment_type" />
                            <field name="to_be_paid" />
                            <field name="money_receipt_id" />
                        </group>
                        <group>
                            <field name="optics_sale_id" />
                            <field name="amount" />
                            <field name="service_charge" />
                            <field name="account_number" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="optics_sale_payment_action" model="ir.actions.act_window">
        <field name="name">optics_sale_payment</field>
        <field name="res_model">optics.sale.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>