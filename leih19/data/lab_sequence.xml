<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="seq_examination_result" model="ir.sequence">
        <field name="name">Examination Result</field>
        <field name="code">examination.result</field>
        <field name="prefix">LAB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_lab_specimen" model="ir.sequence">
        <field name="name">Lab Specimen</field>
        <field name="code">lab.specimen</field>
        <field name="prefix">SPC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_money_receipt" model="ir.sequence">
        <field name="name">Money Receipt</field>
        <field name="code">leih.money.receipt</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
