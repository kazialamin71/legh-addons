<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="commission_calculation_line_tree_view" model="ir.ui.view">
        <field name="name">commission_calculation_line.tree</field>
        <field name="model">commission.calculation.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="commission_calculation_line_ids" />
                <field name="department_id" />
                <field name="test_id" />
                <field name="discount_amount" />
                <field name="test_amount" />
                <field name="mou_payable_commission_var" />
                <field name="mou_payable_commission" />
                <field name="payble_amount" />
                <field name="after_discount_amount" />
                <field name="mou_max_cap" />
            </list>
        </field>
    </record>
    <record id="commission_calculation_line_form_view" model="ir.ui.view">
        <field name="name">commission_calculation_line.form</field>
        <field name="model">commission.calculation.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="commission_calculation_line_ids" />
                            <field name="test_id" />
                            <field name="test_amount" />
                            <field name="mou_payable_commission" />
                            <field name="after_discount_amount" />
                        </group>
                        <group>
                            <field name="department_id" />
                            <field name="discount_amount" />
                            <field name="mou_payable_commission_var" />
                            <field name="payble_amount" />
                            <field name="mou_max_cap" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="commission_calculation_line_action" model="ir.actions.act_window">
        <field name="name">commission_calculation_line</field>
        <field name="res_model">commission.calculation.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>