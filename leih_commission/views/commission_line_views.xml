<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="commission_line_tree_view" model="ir.ui.view">
        <field name="name">commission_line.tree</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="commission_line_ids" />
                <field name="department_id" />
                <field name="description" />
                <field name="name" />
                <field name="charge_item_id" />
                <field name="service_type" />
                <field name="discount_amount" />
                <field name="test_amount" />
                <field name="mou_payable_comm_var" />
                <field name="mou_payable_comm_fixed" />
                <field name="mou_payable_comm_max_cap" />
                <field name="after_discount" />
                <field name="payable_amount" />
                <field name="bill_line_id" />
            </list>
        </field>
    </record>
    <record id="commission_line_form_view" model="ir.ui.view">
        <field name="name">commission_line.form</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="commission_line_ids" />
                            <field name="name" />
                            <field name="test_amount" />
                            <field name="mou_payable_comm_fixed" />
                            <field name="after_discount" />
                            <field name="bill_line_id" />
                            <field name="admission_charge_id" />
                        </group>
                        <group>
                            <field name="department_id" />
                            <field name="charge_item_id" />
                            <field name="service_type" />
                            <field name="discount_amount" />
                            <field name="mou_payable_comm_var" />
                            <field name="mou_payable_comm_max_cap" />
                            <field name="payable_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="commission_line_action" model="ir.actions.act_window">
        <field name="name">commission_line</field>
        <field name="res_model">commission.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Commission accruals (per-bill, awaiting settlement) -->
    <record id="commission_accrual_list_view" model="ir.ui.view">
        <field name="name">commission.accrual.list</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <list string="Commission Accruals" create="false"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="is_referral_discount"
                  decoration-success="state == 'paid'">
                <field name="accrual_date"/>
                <field name="doctor_id"/>
                <field name="broker_id"/>
                <field name="bill_id"/>
                <field name="admission_id"/>
                <field name="accommodation_category_id"/>
                <field name="department_id"/>
                <field name="service_type"/>
                <field name="description"/>
                <field name="name" optional="hide"/>
                <field name="test_amount" sum="Base"/>
                <field name="discount_amount" sum="Discount"/>
                <field name="payable_amount" sum="Payable"/>
                <field name="commission_line_ids" string="Settlement"/>
                <field name="is_referral_discount" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="commission_accrual_search_view" model="ir.ui.view">
        <field name="name">commission.accrual.search</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="doctor_id"/>
                <field name="broker_id"/>
                <field name="bill_id"/>
                <field name="admission_id"/>
                <field name="description"/>
                <field name="name"/>
                <filter name="accrued" string="Accrued (unsettled)" domain="[('state','=','accrued')]"/>
                <filter name="settled" string="Settled" domain="[('state','=','settled')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <separator/>
                <filter name="group_doctor" string="Doctor" context="{'group_by':'doctor_id'}"/>
                <filter name="group_borker" string="Broker" context="{'group_by':'broker_id'}"/>
                <filter name="charge_backs" string="Referral Discounts" domain="[('is_referral_discount','=',True)]"/>
                <separator/>
                <filter name="group_service" string="Service Type" context="{'group_by':'service_type'}"/>
                <filter name="group_accommodation" string="Accommodation" context="{'group_by':'accommodation_category_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="commission_accrual_action" model="ir.actions.act_window">
        <field name="name">Commission Accruals</field>
        <field name="res_model">commission.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="commission_accrual_list_view"/>
        <field name="search_view_id" ref="commission_accrual_search_view"/>
        <field name="context">{'search_default_accrued': 1, 'search_default_group_doctor': 1}</field>
    </record>
</odoo>