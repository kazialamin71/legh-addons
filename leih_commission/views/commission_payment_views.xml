<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="commission_payment_tree_view" model="ir.ui.view">
        <field name="name">commission_payment.list</field>
        <field name="model">commission.payment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="cc_id"/>
                <field name="doctor_id"/>
                <field name="broker_id"/>
                <field name="payment_type"/>
                <field name="paid_amount" sum="Paid"/>
                <field name="due_amount" optional="hide"/>
                <field name="note" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="commission_payment_form_view" model="ir.ui.view">
        <field name="name">commission_payment.form</field>
        <field name="model">commission.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'pending'"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"
                            groups="leih_commission.group_commission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Payment">
                            <field name="cc_id" options="{'no_create': True}"
                                   readonly="state != 'pending'"/>
                            <field name="date" readonly="state != 'pending'"/>
                            <field name="paid_amount" readonly="state != 'pending'"/>
                            <field name="payment_type" readonly="state != 'pending'"/>
                        </group>
                        <group string="Reference">
                            <field name="doctor_id" readonly="1"/>
                            <field name="broker_id" readonly="1"/>
                            <field name="debit_id" readonly="state != 'pending'"/>
                            <field name="credit_id" readonly="state != 'pending'"/>
                            <field name="due_amount" readonly="1"
                                   invisible="state == 'pending'"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1" placeholder="What this payment covers..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commission_payment_action" model="ir.actions.act_window">
        <field name="name">Commission Payments</field>
        <field name="res_model">commission.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
