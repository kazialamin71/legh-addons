<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="commission_configuration_tree_view" model="ir.ui.view">
        <field name="name">commission_configuration.tree</field>
        <field name="model">commission.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="doctor_id" />
                <field name="broker_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="overall_commission_rate" />
                <field name="overall_default_discount" />
                <field name="max_default_discount" />
                <field name="deduct_from_discount" />
                <field name="commission_base" />
                <field name="add_few_departments" />
                <field name="calculation_base_price" />
                <field name="department_ids" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="commission_configuration_form_view" model="ir.ui.view">
        <field name="name">commission_configuration.form</field>
        <field name="model">commission.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'pending'"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_reset_to_pending" type="object" string="Reset to Draft"
                            invisible="state == 'pending'"
                            groups="leih_commission.group_commission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name" />
                            <field name="broker_id" />
                            <field name="end_date" />
                            <field name="overall_default_discount" />
                            <field name="deduct_from_discount" />
                            <field name="commission_base" />
                            <field name="calculation_base_price" />
                        </group>
                        <group>
                            <field name="doctor_id" />
                            <field name="start_date" />
                            <field name="overall_commission_rate" />
                            <field name="max_default_discount" />
                            <field name="add_few_departments" />
                            <field name="department_ids" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Commission Configuration Line">
                            <field name="commission_configuration_line_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="commission_configuration_action" model="ir.actions.act_window">
        <field name="name">commission_configuration</field>
        <field name="res_model">commission.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>