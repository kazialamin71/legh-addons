<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="commission_tree_view" model="ir.ui.view">
        <field name="name">commission.tree</field>
        <field name="model">commission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="ref_doctors" />
                <field name="commission_configuration_id" />
                <field name="commission_rate" />
                <field name="cal_st_date" />
                <field name="cal_end_date" />
                <field name="total_amount" />
                <field name="given_discount_amount" />
                <field name="total_payable_amount" />
                <field name="total_patient" />
                <field name="total_bill" />
                <field name="total_tests" />
                <field name="paid_amount" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="commission_form_view" model="ir.ui.view">
        <field name="name">commission.form</field>
        <field name="model">commission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_gather_accruals" type="object" string="Gather Accruals"
                            class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'pending'"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_register_payment" type="object" string="Register Payment"
                            class="oe_highlight"
                            invisible="state not in ('done', 'partially_paid')"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_settle_balance" type="object" string="Settle Balance"
                            invisible="state not in ('done', 'partially_paid')"
                            groups="leih_commission.group_commission_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('paid', 'cancelled')"
                            groups="leih_commission.group_commission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done,partially_paid,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Information">
                        <group>
                            <field name="ref_doctors" />
                            <field name="broker_id" />
                            <field name="commission_configuration_id" />
                            <field name="cal_st_date" />
                            <field name="cal_end_date" />
                        </group>
                        <group>
                            <field name="total_tests" readonly="1"/>
                            <field name="total_patient" readonly="1"/>
                            <field name="total_bill" readonly="1"/>
                            <field name="given_discount_amount" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="adjustment_amount"
                                   readonly="state in ('paid', 'cancelled')"/>
                            <field name="adjustment_reason"
                                   required="adjustment_amount > 0"
                                   readonly="state in ('paid', 'cancelled')"/>
                            <field name="net_payable_amount" readonly="1"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="balance_amount" readonly="1"
                                   class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commission Line">
                            <field name="commission_line_ids">
                                <list decoration-danger="is_referral_discount">
                                    <field name="accrual_date"/>
                                    <field name="is_referral_discount" column_invisible="1"/>
                                    <field name="bill_id"/>
                                    <field name="admission_id"/>
                                    <field name="accommodation_category_id"/>
                                    <field name="department_id"/>
                                    <field name="name"/>
                                    <field name="test_amount" sum="Base"/>
                                    <field name="discount_amount" sum="Discount"/>
                                    <field name="mou_payable_comm_var"/>
                                    <field name="mou_payable_comm_fixed"/>
                                    <field name="payable_amount" sum="Payable"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list editable="bottom"
                                      decoration-muted="state == 'cancelled'"
                                      decoration-success="state == 'done'">
                                    <field name="name" readonly="1"/>
                                    <field name="date"/>
                                    <field name="payment_type"/>
                                    <field name="paid_amount" sum="Paid"/>
                                    <field name="note"/>
                                    <field name="state" readonly="1"/>
                                    <button name="action_confirm" type="object"
                                            icon="fa-check" title="Confirm"
                                            invisible="state != 'pending'"/>
                                    <button name="action_cancel" type="object"
                                            icon="fa-times" title="Cancel"
                                            invisible="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="commission_action" model="ir.actions.act_window">
        <field name="name">commission</field>
        <field name="res_model">commission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>