<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">

    <record id="module_category_commission" model="ir.module.category">
        <field name="name">Commission</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: groups are grouped under a privilege (res.groups.privilege),
         which carries the module category. -->
    <record id="privilege_commission" model="res.groups.privilege">
        <field name="name">Commission</field>
        <field name="category_id" ref="module_category_commission"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_commission_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_commission"/>
        <field name="comment">View commission accruals/settlements and prepare configurations.</field>
    </record>

    <record id="group_commission_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_commission"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
        <field name="comment">Full control: confirm rules, settle, mark paid, cancel, delete.</field>
    </record>

    <!-- Give the administrator Manager rights so the menus are reachable. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_commission_manager'))]"/>
    </record>

</odoo>
