<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- The settlement sequence (seq_commission) already lives in leih19. Only
         the payment one is new. noupdate: the hospital's numbering is theirs
         once it has started, and an upgrade must not reset the counter. -->
    <data noupdate="1">
        <record id="seq_commission_payment" model="ir.sequence">
            <field name="name">Commission Payment</field>
            <field name="code">commission.payment</field>
            <field name="prefix">CPAY-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
