<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The four buckets that used to be hard-coded, seeded with the same codes
         so every existing charge item and admission line keeps its type.
         noupdate: a hospital that renames "Other Charge" to "Miscellaneous"
         must not have it renamed back on the next upgrade. -->
    <data noupdate="1">
        <record id="charge_type_admission" model="admission.charge.type">
            <field name="code">admission</field>
            <field name="name">Admission Charge</field>
            <field name="service_type">admission</field>
            <field name="sequence">10</field>
        </record>
        <record id="charge_type_icu" model="admission.charge.type">
            <field name="code">icu</field>
            <field name="name">ICU</field>
            <field name="service_type">icu</field>
            <field name="sequence">20</field>
        </record>
        <record id="charge_type_nicu" model="admission.charge.type">
            <field name="code">nicu</field>
            <field name="name">NICU</field>
            <field name="service_type">nicu</field>
            <field name="sequence">30</field>
        </record>
        <record id="charge_type_other" model="admission.charge.type">
            <field name="code">other</field>
            <field name="name">Other Charge</field>
            <field name="service_type">other</field>
            <field name="sequence">90</field>
        </record>
    </data>
</odoo>
