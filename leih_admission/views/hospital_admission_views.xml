<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Phase A: paid is derived; add the advance (down payment) input. -->
    <record id="hospital_admission_form_payments" model="ir.ui.view">
        <field name="name">hospital.admission.form.payments</field>
        <field name="model">hospital.admission</field>
        <field name="inherit_id" ref="leih19.hospital_admission_form_view"/>
        <field name="arch" type="xml">
            <field name="paid" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <!-- The advance input belongs with the payment method, not in the
                 read-only totals column where ``paid`` now lives. -->
            <xpath expr="//group[@name='payment_details']" position="inside">
                <field name="down_payment" readonly="state != 'pending'"/>
            </xpath>

            <!-- Discount, made answerable. "Discount Amount" now includes the
                 per-charge discounts as well as the two admission-level ones, so
                 it reconciles against Total without discount; and a discount the
                 ledger will carry as a contra-revenue debit needs a name against
                 it, which is what the approver and remarks are for. -->
            <field name="after_discount" position="after">
                <field name="line_discount" readonly="1"
                       invisible="line_discount == 0"/>
                <field name="bill_discount" readonly="1"
                       invisible="bill_discount == 0"/>
                <field name="discount_approved_by"
                       invisible="after_discount == 0"
                       required="after_discount != 0"
                       options="{'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="discount_remarks"
                       invisible="after_discount == 0"
                       required="after_discount != 0"
                       placeholder="Why the discount was given"/>
            </field>

            <button name="calculate_bill" position="after">
                <button string="Calculate Payable" type="object"
                        name="action_calculate_payable" class="btn-primary"
                        groups="base.group_user"/>
            </button>

            <!-- Front of the header: the ward prints this the moment the
                 patient is on the record, so it must not sit behind the
                 billing buttons. -->
            <button name="hospital_change_status" position="before">
                <button string="Print Admission Form" type="object"
                        name="action_print_admission_form" class="btn-primary"
                        icon="fa-print" groups="base.group_user"/>
            </button>

            <button name="btn_bill" position="after">
                <button string="Print Statement" type="object"
                        name="action_print_statement" class="btn-secondary"
                        groups="base.group_user"/>
            </button>

            <!-- Header cleanup. The legacy investigation buttons pulled bills in
                 through the pre-Phase-A path that "Calculate Payable" replaced,
                 so keeping them offered two routes to the same numbers; the
                 prescription buttons belong to the OPD flow, not the ward.

                 Hidden, NOT removed. Three other modules graft themselves onto
                 these exact nodes - leih_accounting and leih_pharmacy both use
                 <button name="btn_bill" position="after">, and indoor_management
                 xpaths onto action_view_prescriptions. Deleting a node from an
                 inherited view breaks every module that anchors to it, so the
                 buttons stay in the arch and simply never render. The methods
                 remain on the model either way. -->
            <button name="calculate_bill" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="btn_bill" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_create_prescription" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_view_prescriptions" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <!-- Orphaned once its two buttons went: a count with nothing to open. -->
            <field name="prescription_count" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Hook for the per-state statusbar colours in admission.css. -->
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_admission_form</attribute>
            </xpath>

            <!-- The one way to raise an investigation for an inpatient had no
                 button. The list of bills is readonly (a bill.register has to be
                 created through its own form to get its sequence and to enter the
                 lab pipeline - specimen, sample collection, result), so with no
                 button there was nothing to click at all, and
                 action_new_investigation_bill sat on the model unreachable. -->
            <xpath expr="//page[@name='page_investigation']/field[@name='investigation_bill_ids']" position="before">
                <div class="oe_button_box_inline mb-2">
                    <button string="New Investigation Bill" type="object"
                            name="action_new_investigation_bill" class="btn-primary"
                            icon="fa-plus" groups="base.group_user"
                            invisible="state in ('pending', 'cancelled')"/>
                    <span class="text-muted ms-2"
                          invisible="state not in ('pending', 'cancelled')">
                        Confirm the admission before raising investigation bills.
                    </span>
                </div>
                <div class="text-muted mb-2">
                    Bills raised here follow the lab pipeline and come back onto
                    this admission's charges via <b>Calculate Payable</b>. Their
                    income is recognised with the rest of the admission at final
                    settlement, not when the bill is confirmed.
                </div>
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Charges">
                    <field name="charge_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="service_type"/>
                            <field name="description"/>
                            <field name="unit_id"/>
                            <field name="provider_id" optional="show"/>
                            <field name="qty"/>
                            <field name="unit_price"/>
                            <field name="gross_amount" sum="Gross" optional="hide"/>
                            <field name="discount" sum="Discount"/>
                            <field name="total_amount" sum="Total"/>
                            <!-- What this line credits at settlement. Seeded from
                                 the catalogue item; blank falls back to the
                                 service-type map, then the default income
                                 account, both in Hospital Accounting Settings. -->
                            <field name="income_account_id" optional="show"
                                   options="{'no_create': True}"/>
                            <field name="charge_item_id" optional="hide"/>
                            <field name="is_auto" optional="hide"/>
                            <field name="source_model" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Colour the state in the list too, where it is scanned rather than read. -->
    <record id="hospital_admission_list_state" model="ir.ui.view">
        <field name="name">hospital.admission.list.state</field>
        <field name="model">hospital.admission</field>
        <field name="inherit_id" ref="leih19.hospital_admission_tree_view"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="widget">badge</attribute>
                <attribute name="decoration-warning">state == 'pending'</attribute>
                <attribute name="decoration-success">state == 'activated'</attribute>
                <attribute name="decoration-info">state == 'released'</attribute>
                <attribute name="decoration-danger">state == 'cancelled'</attribute>
            </field>
            <field name="prescription_count" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
